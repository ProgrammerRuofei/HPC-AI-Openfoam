#!/bin/bash
#PBS -N aocc_puse
#PBS -P 59000020
#PBS -q normal
#PBS -l select=1:ncpus=64:mem=128gb
#PBS -l walltime=12:00:00
#PBS -o outputs/a2a_comp_aocc_pgouse_v1.o
#PBS -e outputs/a2a_comp_aocc_pgouse_v1.e

set -eo pipefail
cd "$PBS_O_WORKDIR"
module purge
module load aocc/5.0
module load gcc/11.2.0
module load openmpi/5.0.10-gcc11
export PATH="/app/apps/aocc/5.0/bin:${PATH}"
export OMPI_CC=clang OMPI_CXX=clang++ OMPI_FC=flang
module load cmake/3.31.3
module load flex/2.6.4
bash ./build_a2a_comp_aocc_pgouse.sh
