#!/bin/bash
# Official 4N Sapphire Rapids site-module baseline; do not qsub before probe review.
#PBS -P pm78
#PBS -q normalsr
#PBS -N of2512_spr_4n
#PBS -l ncpus=192
#PBS -l mem=760GB
#PBS -l walltime=02:00:00
#PBS -l storage=scratch/pm78
#PBS -l wd
#PBS -j oe
set -euo pipefail
module purge; module load OpenFOAM/2512
SOURCE_CASE=/scratch/pm78/kj7183/openfoam_cpu/case/occDrivAerStaticMesh
RUN_ROOT=/scratch/pm78/kj7183/openfoam_cpu/official-gadi-spr/baseline-4n; CASE="$RUN_ROOT/case"; EVIDENCE="$RUN_ROOT/evidence/official-spr-4n.${PBS_JOBID}"
test ! -e "$CASE"; mkdir -p "$CASE" "$EVIDENCE"; exec > >(tee -a "$EVIDENCE/run.log") 2>&1
sort -u "$PBS_NODEFILE"; module list 2>&1; lscpu | grep -E 'Model name|Socket|Core|Thread|NUMA'; mpirun --version | head -n 3
cp -a "$SOURCE_CASE/0.orig" "$SOURCE_CASE/constant" "$SOURCE_CASE/system" "$CASE/"
cd "$CASE"; cp system/controlDict.noWrite system/controlDict; cp system/fvSolution.fixedIter system/fvSolution
grep -Eq '^[[:space:]]*endTime[[:space:]]+150;' system/controlDict; cmp -s system/fvSolution system/fvSolution.fixedIter; grep -Eq '^[[:space:]]*nCores[[:space:]]+192;' system/include/caseDefinition; grep -Eq '^[[:space:]]*nHierarchical[[:space:]]+\(16 6 2\);' system/include/caseDefinition
decomposePar -constant; restore0Dir -processor; renumberMesh -constant -overwrite -parallel; potentialFoam -initialiseUBCs -parallel; applyBoundaryLayer -ybl 0.0450244 -parallel
mpirun -np "$PBS_NCPUS" simpleFoam -parallel > "$EVIDENCE/simpleFoam.log" 2>&1
grep -a 'Average wall-clock time per time step' "$EVIDENCE/simpleFoam.log" | tail -n 1
coeff=$(find postProcessing/forceCoeffsAll -name coefficient.dat -type f | head -n 1); test -n "$coeff"; cp "$coeff" "$EVIDENCE/coefficient.dat"
