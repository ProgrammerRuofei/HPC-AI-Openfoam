#!/bin/bash
# Official 2N Sapphire Rapids site-module baseline (80 iterations per the rules).
#PBS -P pm78
#PBS -q normalsr
#PBS -N of2512_spr_2n
#PBS -l ncpus=208
#PBS -l mem=380GB
#PBS -l walltime=01:15:00
#PBS -l storage=scratch/pm78
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/pm78/kj7183/openfoam_cpu/official-gadi-spr/baseline-2n/submit-logs/of2512_spr_2n.pbs.out
set -euo pipefail
module purge; module load OpenFOAM/2512
SOURCE_CASE=/scratch/pm78/kj7183/openfoam_cpu/case/occDrivAerStaticMesh
RUN_ROOT=/scratch/pm78/kj7183/openfoam_cpu/official-gadi-spr/baseline-2n; CASE="$RUN_ROOT/case"; EVIDENCE="$RUN_ROOT/evidence/official-spr-2n.${PBS_JOBID}"
NRANKS=208; NNODES=2; ENDTIME=80; NHIER='(8 13 2)'
test ! -e "$CASE"; mkdir -p "$CASE" "$EVIDENCE"; exec > >(tee -a "$EVIDENCE/run.log") 2>&1
# Preserve Cd evidence unconditionally: a failed or truncated run is exactly the
# one whose coefficient.dat we most need to diagnose it.
preserve_evidence() { rc=$?; set +e; c=$(find "$CASE/postProcessing/forceCoeffsAll" -name coefficient.dat -type f 2>/dev/null | head -n 1); [ -n "$c" ] && cp -f "$c" "$EVIDENCE/coefficient.dat"; printf "script_exit_rc=%s\n" "$rc" >> "$EVIDENCE/run.log"; return $rc; }
trap preserve_evidence EXIT
test "$PBS_NNODES" = "$NNODES"; test "$PBS_NCPUS" = "$NRANKS"
sort -u "$PBS_NODEFILE"; module list 2>&1; lscpu | grep -E 'Model name|Socket|Core|Thread|NUMA'; mpirun --version | head -n 3
cp -a "$SOURCE_CASE/0.orig" "$SOURCE_CASE/constant" "$SOURCE_CASE/system" "$CASE/"
cd "$CASE"; cp system/controlDict.noWrite system/controlDict; cp system/fvSolution.fixedIter system/fvSolution
# Officially permitted per-scaling-point settings only: the rules mandate 40
# iterations at two nodes, and one rank per physical core on 2x104-core SPR nodes.
# 208 = 2^4 x 13, so 13 is a forced factor of any decomposition; this keeps the
# 4N baseline's y=13, z=2 and scales only the streamwise dimension.
sed -i -E "s/^([[:space:]]*endTime[[:space:]]+)[0-9]+;/\\1${ENDTIME};/" system/controlDict
sed -i -E "s/^([[:space:]]*nCores[[:space:]]+)[0-9]+;/\\1${NRANKS};/" system/include/caseDefinition
sed -i -E "s/^([[:space:]]*nHierarchical[[:space:]]+)\\([^)]*\\);/\\1${NHIER};/" system/include/caseDefinition
grep -Eq "^[[:space:]]*endTime[[:space:]]+${ENDTIME};" system/controlDict; cmp -s system/fvSolution system/fvSolution.fixedIter; grep -Eq "^[[:space:]]*nCores[[:space:]]+${NRANKS};" system/include/caseDefinition; grep -Eq '^[[:space:]]*nHierarchical[[:space:]]+\(8 13 2\);' system/include/caseDefinition
decomposePar -constant; restore0Dir -processor; renumberMesh -constant -overwrite -parallel; potentialFoam -initialiseUBCs -parallel; applyBoundaryLayer -ybl 0.0450244 -parallel
mpirun -np "$NRANKS" simpleFoam -parallel > "$EVIDENCE/simpleFoam.log" 2>&1
grep -a 'Average wall-clock time per time step' "$EVIDENCE/simpleFoam.log" | tail -n 1 || true
