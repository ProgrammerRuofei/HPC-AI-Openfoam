#!/bin/bash
# Two identical, unprofiled Opt runs to measure stall recurrence on one allocation.
#PBS -N of_sc_stall_v1
#PBS -P 59000020
#PBS -q normal
#PBS -l select=4:ncpus=128:mpiprocs=128:mem=400gb
#PBS -l place=scatter
