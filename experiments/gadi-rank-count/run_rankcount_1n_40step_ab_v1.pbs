#!/bin/bash
# One allocation, one SPR host: paired 104/96-rank Scotch 40-step experiment.
# Change only rank count; preserve the validated GCC16.2/Open MPI5.0.10 stack.
#PBS -P pm78
#PBS -q normalsr
#PBS -N gcc162_rank_ab
#PBS -l ncpus=104
#PBS -l mem=190GB
#PBS -l jobfs=100GB
#PBS -l walltime=00:40:00
#PBS -l storage=scratch/pm78
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/gadi-gcc162-ompi5010/submit-logs/run_rankcount_1n_40step_ab_v1.pbs.out
set -euo pipefail

STACK_ROOT=/scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/gadi-gcc162-ompi5010
OF_ROOT=/scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/gadi-gcc162-ompi5010-of2512
SOURCE_CASE=/scratch/pm78/kj7183/openfoam_cpu/case/occDrivAerStaticMesh
GCC_ARCHIVE="$STACK_ROOT/runtime-archive/gcc-16.2.0.181342083.gadi-pbs.tar.gz"
MPI_ARCHIVE="$STACK_ROOT/runtime-archive/openmpi-5.0.10.181346004.gadi-pbs.tar.gz"
OF_ARCHIVE="$OF_ROOT/runtime-archive/gadi-gcc162-ompi5010-of2512.181360543.gadi-pbs.tar.gz"
GCC_SHA=1149c0d97412ae3741cc18d60f233cdd3dd5e33bc92c55c59db2dd8cf535b714
MPI_SHA=8ac121e4f64eb329dc33cd2cc8229dc9f655064a757cbcaa36af962b21619fc6
OF_SHA=64cd075a385938f0c9ac0c478066349e5bb198f5fa8cd80cc3ed61fb12286281
BIN_SHA=b3b992619ea5b9805fe1c549d2dafafe6cba88411bd152f7b1eb50081fc867c5
RUN_ROOT="$OF_ROOT/rank-count-1n-40step/${PBS_JOBID:?}"
EVIDENCE="$RUN_ROOT/evidence"
LOCAL_ROOT="${PBS_JOBFS:?}/of2512-gcc162-rank-count-${PBS_JOBID}"
GCC_PREFIX="$LOCAL_ROOT/gcc-16.2.0"
MPI_PREFIX="$LOCAL_ROOT/openmpi-5.0.10"
FOAM_ROOT="$LOCAL_ROOT/OpenFOAM-v2512"
CURRENT_RANKS=

test "${PBS_NNODES:?}" -eq 1
test "${PBS_NCPUS:?}" -eq 104
test ! -e "$RUN_ROOT"
test ! -e "$LOCAL_ROOT"
mkdir -p "$EVIDENCE" "$LOCAL_ROOT"
exec > >(tee "$EVIDENCE/run.log") 2>&1
preserve() {
    rc=$?; set +e
    if [[ -n "$CURRENT_RANKS" ]]; then
        arm_evidence="$EVIDENCE/$CURRENT_RANKS"
        arm_case="$LOCAL_ROOT/case-$CURRENT_RANKS"
        coefficient=$(find "$arm_case/postProcessing/forceCoeffsAll" -name coefficient.dat -type f 2>/dev/null | head -n 1)
        test -n "$coefficient" && cp -p "$coefficient" "$arm_evidence/coefficient.dat"
    fi
    printf 'script_exit_rc=%s\n' "$rc" > "$EVIDENCE/exit-status.txt"
    return "$rc"
}
trap preserve EXIT

printf 'pbs_jobid=%s\nstack=gcc16.2-ompi5.0.10-openfoamv2512\ndecomposition=scotch\nrank_arms=104,96\nsteps_per_arm=40\nbinding=OpenMPI_default\n' "$PBS_JOBID" > "$EVIDENCE/provenance.txt"
sort -u "$PBS_NODEFILE" > "$EVIDENCE/nodes.txt"
test "$(wc -l < "$PBS_NODEFILE")" -eq 104
test "$(wc -l < "$EVIDENCE/nodes.txt")" -eq 1
lscpu | grep -E 'Model name|Socket|Core|Thread|NUMA' > "$EVIDENCE/lscpu.txt"
grep -Fq 'Xeon(R) Platinum 8470Q' "$EVIDENCE/lscpu.txt"
module purge
module load ucx/1.18.1 ucc/1.4.4
module list 2>&1 | tee "$EVIDENCE/modules.txt"
test "${UCX_ROOT:?}" = /apps/ucx/1.18.1
test "${UCC_ROOT:?}" = /apps/ucc/1.4.4

cat > "$EVIDENCE/expected-source.sha256" <<EOF
2a02ec456ce880b2242d566da6c5b28fae1aa99218169260030cd53f5a662ec3  $SOURCE_CASE/Allrun.gadi
1da44731f5f723c1b8471bee6c6186c6f402f63154f84cacd26bf27e30e6a6c6  $SOURCE_CASE/system/include/caseDefinition
ce4ec0f52bcc88eea8402b454940dc5aad1f31dea6441e7d98413b651427ef06  $SOURCE_CASE/system/controlDict.noWrite
064bb50455d37a7edd2c0fb24bbe30baaf851623f0250d550450c10e407889b3  $SOURCE_CASE/system/fvSchemes
5e1db8548ee82c44f8fa3377a80971af2b5aabb95b3ee7efcd8b723c5dcab1ba  $SOURCE_CASE/system/fvSolution
5e1db8548ee82c44f8fa3377a80971af2b5aabb95b3ee7efcd8b723c5dcab1ba  $SOURCE_CASE/system/fvSolution.fixedIter
0a0e5d072527bc1e67e5bc505da30bec0abebc67262aa47ecaece4d13b2ece08  $SOURCE_CASE/system/FOwallClockTimeStatistics
EOF
sha256sum -c "$EVIDENCE/expected-source.sha256"
printf '%s  %s\n' "$GCC_SHA" "$GCC_ARCHIVE" | sha256sum -c -
printf '%s  %s\n' "$MPI_SHA" "$MPI_ARCHIVE" | sha256sum -c -
printf '%s  %s\n' "$OF_SHA" "$OF_ARCHIVE" | sha256sum -c -
tar -xzf "$GCC_ARCHIVE" -C "$LOCAL_ROOT"
tar -xzf "$MPI_ARCHIVE" -C "$LOCAL_ROOT"
tar -xzf "$OF_ARCHIVE" -C "$LOCAL_ROOT"
export OPAL_PREFIX="$MPI_PREFIX" PMIX_PREFIX="$MPI_PREFIX" PRTE_PREFIX="$MPI_PREFIX"
export OMPI_CC="$GCC_PREFIX/bin/gcc" OMPI_CXX="$GCC_PREFIX/bin/g++"
export PATH="$MPI_PREFIX/bin:$GCC_PREFIX/bin:$PATH"
export LD_LIBRARY_PATH="$MPI_PREFIX/lib:$GCC_PREFIX/lib64:/opt/pbs/default/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
gcc --version | head -n 1 | grep -Fx 'gcc (GCC) 16.2.0'
mpirun --version | head -n 1 | grep -Fx 'mpirun (Open MPI) 5.0.10'
mpicc --showme:command | grep -Fx "$GCC_PREFIX/bin/gcc"
BIN="$FOAM_ROOT/platforms/linux64GccDPInt32Opt/bin/simpleFoam"
printf '%s  %s\n' "$BIN_SHA" "$BIN" | sha256sum -c -
set +u; . "$FOAM_ROOT/etc/bashrc" WM_COMPILER=Gcc WM_MPLIB=SYSTEMOPENMPI WM_COMPILE_OPTION=Opt; set -u
test "$WM_PROJECT_DIR" = "$FOAM_ROOT"
test "$WM_OPTIONS" = linux64GccDPInt32Opt
ldd "$BIN" > "$EVIDENCE/simpleFoam.ldd"
! grep -Fq 'not found' "$EVIDENCE/simpleFoam.ldd"
grep -F "libmpi.so.40 => $MPI_PREFIX/lib/" "$EVIDENCE/simpleFoam.ldd"

for ranks in 104 96; do
    CURRENT_RANKS="$ranks"
    arm_evidence="$EVIDENCE/$ranks"
    arm_case="$LOCAL_ROOT/case-$ranks"
    mkdir "$arm_evidence" "$arm_case"
    printf 'pbs_jobid=%s\nranks=%s\nsteps=40\n' "$PBS_JOBID" "$ranks" > "$arm_evidence/provenance.txt"
    cp -a "$SOURCE_CASE/0.orig" "$SOURCE_CASE/constant" "$SOURCE_CASE/system" "$arm_case/"
    for part in faces owner neighbour points; do
        cmp -s "$SOURCE_CASE/constant/polyMesh/$part" "$arm_case/constant/polyMesh/$part"
    done
    cd "$arm_case"
    cp system/controlDict.noWrite system/controlDict
    cp system/fvSolution.fixedIter system/fvSolution
    sed -i -E "s/^([[:space:]]*nCores[[:space:]]+)[0-9]+;/\\1${ranks};/" system/include/caseDefinition
    sed -i -E 's/^([[:space:]]*decompositionMethod[[:space:]]+)[a-z]+;/\1scotch;/' system/include/caseDefinition
    sed -i -E 's/^([[:space:]]*endTime[[:space:]]+)[0-9]+;/\140;/' system/controlDict
    grep -Eq "^[[:space:]]*nCores[[:space:]]+${ranks};" system/include/caseDefinition
    grep -Eq '^[[:space:]]*decompositionMethod[[:space:]]+scotch;' system/include/caseDefinition
    grep -Eq '^[[:space:]]*endTime[[:space:]]+40;' system/controlDict
    cmp -s system/fvSolution system/fvSolution.fixedIter
    sha256sum system/fvSchemes system/fvSolution system/controlDict.noWrite > "$arm_evidence/case-inputs.sha256"
    set +u; . "$FOAM_ROOT/bin/tools/RunFunctions"; set -u
    decomposePar -constant > "$arm_evidence/10_decomposePar.log" 2>&1
    grep -Fq 'Decomposition method scotch' "$arm_evidence/10_decomposePar.log"
    grep -aEq '^End$' "$arm_evidence/10_decomposePar.log"
    restore0Dir -processor
    test "$(find . -mindepth 1 -maxdepth 1 -type d -name 'processor*' | wc -l)" -eq "$ranks"

    PAREX=(mpirun --prefix "$MPI_PREFIX" --map-by "ppr:${ranks}:node" --mca pml ucx -np "$ranks")
    "${PAREX[@]}" --report-bindings /bin/bash -c 'printf "%s %s %s\n" "${OMPI_COMM_WORLD_RANK:?}" "$(hostname)" "$(awk '\''/Cpus_allowed_list/{print $2}'\'' /proc/self/status)"' > "$arm_evidence/rank-affinity.txt" 2> "$arm_evidence/mpi-bindings.txt"
    awk -v r="$ranks" '{ if ($1<0 || $1>=r || seen[$1]++) bad=1; host[$2]=1 } END { if (NR!=r || bad || length(host)!=1) exit 1 }' "$arm_evidence/rank-affinity.txt"
    "${PAREX[@]}" renumberMesh -constant -overwrite -parallel > "$arm_evidence/20_renumberMesh.log" 2>&1
    "${PAREX[@]}" potentialFoam -initialiseUBCs -parallel > "$arm_evidence/30_potentialFoam.log" 2>&1
    "${PAREX[@]}" applyBoundaryLayer -ybl 0.0450244 -parallel > "$arm_evidence/40_applyBoundaryLayer.log" 2>&1
    "${PAREX[@]}" "$BIN" -parallel > "$arm_evidence/simpleFoam.log" 2>&1
    for step in 10_decomposePar 20_renumberMesh 30_potentialFoam 40_applyBoundaryLayer; do
        grep -aEq '^End$' "$arm_evidence/$step.log"
    done
    grep -aEq '^Time = 40[[:space:]]*$' "$arm_evidence/simpleFoam.log"
    grep -aFq 'Finalising parallel run' "$arm_evidence/simpleFoam.log"
    grep -aEq '^End$' "$arm_evidence/simpleFoam.log"
    grep -a 'Average wall-clock time per time step' "$arm_evidence/simpleFoam.log" | tail -n 1 | tee "$arm_evidence/avg-step-time.txt"
    grep -aE 'ExecutionTime|ClockTime' "$arm_evidence/simpleFoam.log" | tail -n 1 | tee "$arm_evidence/clocktime.txt"
    coefficient=$(find "$arm_case/postProcessing/forceCoeffsAll" -name coefficient.dat -type f | head -n 1)
    test -s "$coefficient"
    cp -p "$coefficient" "$arm_evidence/coefficient.dat"
    cd_value=$(awk '/^#/ { for (i=2;i<=NF;i++) if ($i=="Cd") col=i-1; next } NF && col { last=$col } END { if (col) print last }' "$arm_evidence/coefficient.dat")
    python3 - "$cd_value" <<'PY'
import math, sys
value = float(sys.argv[1])
assert math.isfinite(value) and 0.42 < value < 0.45
PY
    printf 'final_Cd=%s\n' "$cd_value" | tee "$arm_evidence/final-Cd.txt"
    echo "GCC162_OMPI5010_SCOTCH_1N_40STEP_${ranks}_PASS"
done
echo GCC162_OMPI5010_SCOTCH_1N_40STEP_104_96_AB_PASS
