#!/bin/bash
# 4-node / 416-rank hierarchical decomposition A/B on Gadi normalsr.
# ARM: BASELINE, hierarchical (16 13 2) -- the official decomposition
#
# DECOMPOSITION SCREENING / CONTROLLED EXPERIMENT -- NOT an official scored
# result. The authoritative official harness stays in official-gadi-spr/; this
# script deliberately mirrors its chain and semantics so a valid result here can
# be compared scientifically against the other arm, but it must never be quoted
# as an official competition figure.
#
# The two arms differ ONLY in the hierarchical tuple and the names derived from
# it. Everything below the header block is byte-identical between them.
#PBS -P pm78
#PBS -q normalsr
#PBS -N of2512_4n_decomp_16x13x2
#PBS -l ncpus=416
#PBS -l mem=760GB
#PBS -l walltime=00:30:00
#PBS -l storage=scratch/pm78
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/pm78/kj7183/openfoam_cpu/experiments/gadi-4n-decomp/baseline-16x13x2/submit-logs/of2512_4n_decomp_16x13x2.pbs.out
set -euo pipefail

# ------------------------------------------------------------ arm definition
ARM_LABEL=baseline
ARM_DIR=baseline-16x13x2
NHIER='(16 13 2)'
NHIER_REGEX='\(16 13 2\)'

# ------------------------------------------------------------- fixed for both
SOURCE_CASE=/scratch/pm78/kj7183/openfoam_cpu/case/occDrivAerStaticMesh
RUN_ROOT="/scratch/pm78/kj7183/openfoam_cpu/experiments/gadi-4n-decomp/${ARM_DIR}"
CASE="${RUN_ROOT}/case"
EVIDENCE="${RUN_ROOT}/evidence/gadi-4n-decomp-${ARM_LABEL}.${PBS_JOBID:?}"
NRANKS=416
NNODES=4
RANKS_PER_NODE=104
ENDTIME=150
YBL=0.0450244

# Authoritative 65M workload identity, identical to the Phase 0 R1-R4 evidence.
EXPECTED_SHA_ALLRUN=2a02ec456ce880b2242d566da6c5b28fae1aa99218169260030cd53f5a662ec3
EXPECTED_SHA_CASEDEF=1da44731f5f723c1b8471bee6c6186c6f402f63154f84cacd26bf27e30e6a6c6
EXPECTED_SHA_CONTROLDICT_NOWRITE=ce4ec0f52bcc88eea8402b454940dc5aad1f31dea6441e7d98413b651427ef06
EXPECTED_SHA_FVSCHEMES=064bb50455d37a7edd2c0fb24bbe30baaf851623f0250d550450c10e407889b3
EXPECTED_SHA_FVSOLUTION=5e1db8548ee82c44f8fa3377a80971af2b5aabb95b3ee7efcd8b723c5dcab1ba
EXPECTED_SHA_FVSOLUTION_FIXEDITER=5e1db8548ee82c44f8fa3377a80971af2b5aabb95b3ee7efcd8b723c5dcab1ba

# Fresh-case protection, mirroring the official harness: refuse rather than
# clobber. Nothing is deleted by this script; a previous run's case must be
# removed deliberately by the operator, so no unknown data is ever destroyed.
test ! -e "$CASE" || { echo "ERROR: case already exists, refusing to reuse: $CASE" >&2; exit 2; }
mkdir -p "$CASE" "$EVIDENCE"
exec > >(tee -a "${EVIDENCE}/run.log") 2>&1

# A failed or truncated run is exactly the one whose evidence is most needed.
preserve_evidence()
{
    rc=$?
    set +e
    c=$(find "${CASE}/postProcessing/forceCoeffsAll" -name coefficient.dat -type f 2>/dev/null | head -n 1)
    [ -n "$c" ] && cp -f "$c" "${EVIDENCE}/coefficient.dat"
    printf 'script_exit_rc=%s\n' "$rc" > "${EVIDENCE}/exit-status.txt"
    return $rc
}
trap preserve_evidence EXIT

echo '===== ARM / PROVENANCE ====='
printf 'arm=%s\ndecomposition=hierarchical %s\npbs_jobid=%s\nofficial_result=false\nclassification=DECOMPOSITION SCREENING\n' \
    "$ARM_LABEL" "$NHIER" "$PBS_JOBID"
if command -v git >/dev/null 2>&1 && git -C /scratch/pm78/kj7183/openfoam_cpu/control-repo rev-parse HEAD >/dev/null 2>&1; then
    printf 'control_repo_commit=%s\n' "$(git -C /scratch/pm78/kj7183/openfoam_cpu/control-repo rev-parse HEAD)"
else
    printf 'control_repo_commit=unavailable\n'
fi

echo '===== ALLOCATION GATES ====='
sort -u "$PBS_NODEFILE" | tee "${EVIDENCE}/nodes.txt"
allocated_nodes=$(sort -u "$PBS_NODEFILE" | wc -l | tr -d ' ')
slots_per_node=$(awk '{c[$0]++} END {for (h in c) print c[h]}' "$PBS_NODEFILE" | sort -u)
printf 'allocated_nodes=%s\nslots_per_node=%s\npbs_ncpus=%s\n' "$allocated_nodes" "$slots_per_node" "${PBS_NCPUS:?}"
test "$allocated_nodes" -eq "$NNODES"        || { echo 'ERROR: node count' >&2; exit 3; }
test "$PBS_NCPUS" -eq "$NRANKS"              || { echo 'ERROR: rank count' >&2; exit 3; }
test "$slots_per_node" = "$RANKS_PER_NODE"   || { echo 'ERROR: ranks per node' >&2; exit 3; }

echo '===== TOOLCHAIN ====='
module purge
module load OpenFOAM/2512
module list 2>&1 | tee "${EVIDENCE}/modules.txt"
lscpu | grep -E 'Model name|Socket|Core|Thread|NUMA' | tee "${EVIDENCE}/lscpu.txt"
mpirun --version > "${EVIDENCE}/mpirun.version" 2>&1; head -n 1 "${EVIDENCE}/mpirun.version"
printf 'WM_PROJECT_VERSION=%s\nWM_OPTIONS=%s\nWM_MPLIB=%s\n' \
    "${WM_PROJECT_VERSION:-UNSET}" "${WM_OPTIONS:-UNSET}" "${WM_MPLIB:-UNSET}" | tee "${EVIDENCE}/foam-env.txt"

echo '===== WORKLOAD IDENTITY (authoritative source, before any edit) ====='
cat > "${EVIDENCE}/expected-workload.sha256" <<SHAEOF
${EXPECTED_SHA_ALLRUN}  ${SOURCE_CASE}/Allrun.gadi
${EXPECTED_SHA_CASEDEF}  ${SOURCE_CASE}/system/include/caseDefinition
${EXPECTED_SHA_CONTROLDICT_NOWRITE}  ${SOURCE_CASE}/system/controlDict.noWrite
${EXPECTED_SHA_FVSCHEMES}  ${SOURCE_CASE}/system/fvSchemes
${EXPECTED_SHA_FVSOLUTION}  ${SOURCE_CASE}/system/fvSolution
${EXPECTED_SHA_FVSOLUTION_FIXEDITER}  ${SOURCE_CASE}/system/fvSolution.fixedIter
SHAEOF
sha256sum -c "${EVIDENCE}/expected-workload.sha256" || { echo 'ERROR: workload identity mismatch' >&2; exit 4; }

echo '===== FRESH CASE ====='
cp -a "${SOURCE_CASE}/0.orig" "${SOURCE_CASE}/constant" "${SOURCE_CASE}/system" "${CASE}/"
cd "$CASE"
if find . -maxdepth 1 -type d -name 'processor*' | grep -q .; then
    echo 'ERROR: fresh case unexpectedly contains processor state' >&2; exit 5
fi
test -f constant/polyMesh/points || { echo 'ERROR: mesh missing' >&2; exit 5; }

echo '===== CONFIGURATION ====='
cp system/controlDict.noWrite system/controlDict
cp system/fvSolution.fixedIter system/fvSolution
sed -i -E "s/^([[:space:]]*nCores[[:space:]]+)[0-9]+;/\1${NRANKS};/" system/include/caseDefinition
sed -i -E "s/^([[:space:]]*nHierarchical[[:space:]]+)\([^)]*\);/\1${NHIER};/" system/include/caseDefinition
grep -E 'nCores|decompositionMethod|nHierarchical' system/include/caseDefinition | tee "${EVIDENCE}/decomposition.txt"
grep -E 'startFrom|startTime|endTime|deltaT' system/controlDict | tee "${EVIDENCE}/controldict.txt"

grep -Eq "^[[:space:]]*endTime[[:space:]]+${ENDTIME};" system/controlDict \
    || { echo 'ERROR: endTime gate' >&2; exit 6; }
grep -Eq "^[[:space:]]*nCores[[:space:]]+${NRANKS};" system/include/caseDefinition \
    || { echo 'ERROR: nCores gate' >&2; exit 7; }
grep -Eq '^[[:space:]]*decompositionMethod[[:space:]]+hierarchical;' system/include/caseDefinition \
    || { echo 'ERROR: decompositionMethod gate' >&2; exit 8; }
grep -Eq "^[[:space:]]*nHierarchical[[:space:]]+${NHIER_REGEX};" system/include/caseDefinition \
    || { echo 'ERROR: nHierarchical gate' >&2; exit 9; }
cmp -s system/fvSolution system/fvSolution.fixedIter \
    || { echo 'ERROR: fixedIter gate' >&2; exit 10; }
sha256sum system/controlDict.noWrite system/fvSchemes system/fvSolution system/fvSolution.fixedIter \
    | tee "${EVIDENCE}/observed-workload.sha256"

echo '===== CHAIN (verbatim from the official 4N SPR harness) ====='
# restore0Dir is a RunFunctions shell function, not a binary; sourcing under
# set -u trips on FOAM_LD_LIBRARY_PATH, so nounset is lifted for the source only.
set +u
. "${WM_PROJECT_DIR:?}/bin/tools/RunFunctions"
set -u
type restore0Dir | head -n 1

PAREX="mpirun -np ${NRANKS}"
decomposePar -constant                             > "${EVIDENCE}/10_decomposePar.log" 2>&1
restore0Dir -processor
$PAREX renumberMesh -constant -overwrite -parallel > "${EVIDENCE}/20_renumberMesh.log" 2>&1
$PAREX potentialFoam -initialiseUBCs -parallel     > "${EVIDENCE}/30_potentialFoam.log" 2>&1
$PAREX applyBoundaryLayer -ybl "${YBL}" -parallel  > "${EVIDENCE}/40_applyBoundaryLayer.log" 2>&1
$PAREX simpleFoam -parallel                        > "${EVIDENCE}/simpleFoam.log" 2>&1

echo '===== COMPLETION GATES ====='
SOLVER_LOG="${EVIDENCE}/simpleFoam.log"
test -s "$SOLVER_LOG"
grep -aEq "^Time = ${ENDTIME}[[:space:]]*$" "$SOLVER_LOG" || { echo 'ERROR: endTime not reached' >&2; exit 11; }
grep -aFq 'Finalising parallel run' "$SOLVER_LOG"         || { echo 'ERROR: no parallel finalisation' >&2; exit 11; }
grep -aEq '^End$' "$SOLVER_LOG"                           || { echo 'ERROR: no End marker' >&2; exit 11; }

grep -a 'Average wall-clock time per time step' "$SOLVER_LOG" | tail -n 1 | tee "${EVIDENCE}/avg-step-time.txt"
grep -aE 'ExecutionTime|ClockTime' "$SOLVER_LOG" | tail -n 1 | tee "${EVIDENCE}/clocktime.txt"
grep -a -A4 '^Statistics:' "$SOLVER_LOG" | tail -n 5 | tee "${EVIDENCE}/statistics.txt"
tail -n 20 "$SOLVER_LOG"

printf 'arm=%s\npbs_jobid=%s\nnodes=%s\nranks=%s\nranks_per_node=%s\ndecomposition=hierarchical %s\nendtime=%s\nybl=%s\nofficial_result=false\nclassification=DECOMPOSITION SCREENING\n' \
    "$ARM_LABEL" "$PBS_JOBID" "$NNODES" "$NRANKS" "$RANKS_PER_NODE" "$NHIER" "$ENDTIME" "$YBL" \
    > "${EVIDENCE}/provenance.txt"
echo DECOMP_SCREEN_PASS
