#!/bin/bash
# PROPOSED / NOT SUBMITTED
# v2 fixes the v1 report-heading validation defect observed after P0 in job
# 25695102; all scientific inputs, resources and runtime choices are retained.
# Step 3: clean AOCC/Open MPI/KaHIP control-profile-control experiment.
# Expected working directory: the synchronized ASPIRE2A control repository.
# Inputs: the fixed 65M template, verified Opt simpleFoam, private mpiP 3.5,
# and the retained baseline libfabric. Outputs: a fresh run root in scratch
# containing logs, correctness evidence, affinity, hashes and one mpiP report.
# No source, mesh, numerical-scheme, solver-setting or build change is made.
#PBS -N of_step3_mpip_v2
#PBS -P 59000020
#PBS -q normal
#PBS -l select=4:ncpus=128:mpiprocs=128:ompthreads=1:mem=400gb
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -o /home/project/59000020/openfoam-isc26/control-repo/scripts/outputs/step3_clean_mpip_v2.o
#PBS -e /home/project/59000020/openfoam-isc26/control-repo/scripts/outputs/step3_clean_mpip_v2.e

set -euo pipefail

CONTROL_REPO=/home/project/59000020/openfoam-isc26/control-repo
FOAM_INST_DIR="${HOME}/scratch/openfoam-v2512"
OF_DIR="${FOAM_INST_DIR}/OpenFOAM-v2512"
TEMPLATE_LINK="${FOAM_INST_DIR}/cases/occDrivAerStaticMesh-template"
MPIP_LIB="${HOME}/scratch/tools/mpiP-install/lib/libmpiP.so"
RUN_ROOT="${FOAM_INST_DIR}/cases/step3-clean-mpip-v2-${PBS_JOBID%%.*}"
CASE="${RUN_ROOT}/case"
EVIDENCE="${RUN_ROOT}/evidence"
NRANKS=512
NNODES=4
RANKS_PER_NODE=128
ENDTIME=40
JOB_START_EPOCH=$(date +%s)

EXPECTED_SHA_CASEDEF=cc8476b011c0b6d04e9e4495c12078885218d81a8377ca1543d0477a21b891e7
EXPECTED_SHA_DECOMPOSE=ee76e1b47f56d98d5552de3c60e75801f194249bea8f47c19a0ac2816a570829
EXPECTED_SHA_CONTROL_NOWRITE=5d497aa829c0369dc3252a5af03043bc099d4ac31f39c780fc3184c602687c0c
EXPECTED_SHA_FVSCHEMES=064bb50455d37a7edd2c0fb24bbe30baaf851623f0250d550450c10e407889b3
EXPECTED_SHA_FVSOLUTION_FIXED=5e1db8548ee82c44f8fa3377a80971af2b5aabb95b3ee7efcd8b723c5dcab1ba
EXPECTED_SHA_FORCECOEFFS=4a66f9792320ef7775486f34a80185e3ab384f3529a231f448c3f80c78c7d001
EXPECTED_SHA_U=bcec9e7b7c5fdff940d960b4f32a1abde445411a9efaad24c4a9c4c8160fd8e8
EXPECTED_SHA_TRANSPORT=4994e93eac7370fc2f8921e7cef59022f1f677319bbb8e0e5187ff777ee90f27
EXPECTED_SHA_TURBULENCE=aa80a06db5870f620e484df3f97098c105c534bd473b114de99497b6f75c1e58
EXPECTED_SHA_POINTS=7c43587be473796d67fd735ba3e7b76733b5c93540123fad85c4b1d2b7b47a7e
EXPECTED_SHA_FACES=9aef04138f5107dbb47257cfca1b15eb0ba478b0963f1557d7d0b69ee534512d
EXPECTED_SHA_OWNER=7e784350e2e8c00f2fac9f847c94b7e3b317c9deb1740a8512b809b5863f80b2
EXPECTED_SHA_NEIGHBOUR=b5b0f90fbac0dc966c235b28c5712e4f2d38535a4f1e05b2f9ddbbc490545fea
EXPECTED_SHA_BOUNDARY=3f34abc678836a67f87bfea30c707df0a5571aaafa1e303d4b0b6ff5cc7c519b
EXPECTED_SHA_LIBFABRIC=4959baaffd6620659f9878693faba31bd3ac7c382a0e576a9e1816653873407f
EXPECTED_SHA_SIMPLEFOAM=7846a1250d3b95a80507f907f5a1ed9d2281a75b1bfd18d47af24b5105d2609f
EXPECTED_SHA_MPIP=017bfc27b8ff4e767d46e77e9c2df698e90d085367feb5f25834d84d631841ba

test "$(readlink -f "${PBS_O_WORKDIR:?}")" = "$(readlink -f "$CONTROL_REPO")"
test ! -e "$RUN_ROOT" || { echo "ERROR: refusing to reuse $RUN_ROOT" >&2; exit 2; }
mkdir -p "$CASE" "$EVIDENCE"
exec > >(tee -a "$EVIDENCE/run.log") 2>&1

preserve_status()
{
    rc=$?
    set +e
    printf 'script_exit_rc=%s\n' "$rc" > "$EVIDENCE/exit-status.txt"
    return "$rc"
}
trap preserve_status EXIT

printf 'classification=PROFILING DIAGNOSTIC\nofficial_result=false\nprofiled=true\njob=%s\n' "$PBS_JOBID"

echo '===== ALLOCATION ====='
sort -u "$PBS_NODEFILE" | tee "$EVIDENCE/nodes.txt"
cp -p "$PBS_NODEFILE" "$EVIDENCE/pbs-nodefile.txt"
test "$(sort -u "$PBS_NODEFILE" | wc -l | tr -d ' ')" -eq "$NNODES"
test "$(wc -l < "$PBS_NODEFILE" | tr -d ' ')" -eq "$NRANKS"
slots_per_node=$(awk '{n[$0]++} END {for (h in n) print n[h]}' "$PBS_NODEFILE" | sort -u)
test "$slots_per_node" = "$RANKS_PER_NODE"

echo '===== TOOLCHAIN ====='
module purge
module load aocc/5.0
module load gcc/11.2.0
module load openmpi/5.0.10-gcc11
module list 2>&1 | tee "$EVIDENCE/modules.txt"
export PATH="/app/apps/aocc/5.0/bin:${PATH}"
export OMPI_CC=clang
export OMPI_CXX=clang++
export OMPI_FC=flang
unset LD_PRELOAD MPIP || true

FABRIC_CANDIDATES=(
    /scratch/users/industry/ai-hpc/apacsc20/openfoam-v2512/ext/libfabric/lib/libfabric.so.1
    /scratch/users/industry/ai-hpc/apacsc20/openfoam-v2512/ext/libfabric-1.22.0-from-login/lib64/libfabric.so.1
)
FABRIC_LIB=
for candidate in "${FABRIC_CANDIDATES[@]}"; do
    if test -r "$candidate"; then
        FABRIC_LIB=$candidate
        break
    fi
done
test -n "$FABRIC_LIB" || {
    printf 'ERROR: no retained baseline libfabric is readable\n' >&2
    printf 'checked=%s\n' "${FABRIC_CANDIDATES[@]}" >&2
    exit 3
}
test "$(sha256sum "$(readlink -f "$FABRIC_LIB")" | awk '{print $1}')" = "$EXPECTED_SHA_LIBFABRIC"
ls -l "$FABRIC_LIB" | tee "$EVIDENCE/libfabric.ls.txt"
readlink -f "$FABRIC_LIB" | tee "$EVIDENCE/libfabric.realpath.txt"
sha256sum "$(readlink -f "$FABRIC_LIB")" | tee "$EVIDENCE/libfabric.sha256"
export FOAM_EXTRA_LD_LIBRARY_PATH="$(dirname "$FABRIC_LIB")"
export LD_LIBRARY_PATH="${FOAM_EXTRA_LD_LIBRARY_PATH}:${LD_LIBRARY_PATH:-}"
printf 'LD_LIBRARY_PATH=%s\n' "$LD_LIBRARY_PATH" > "$EVIDENCE/ld-library-path.txt"
export FOAM_INST_DIR

test -r "$MPIP_LIB" || { echo "ERROR: mpiP library is unreadable: $MPIP_LIB" >&2; exit 3; }
test "$(sha256sum "$MPIP_LIB" | awk '{print $1}')" = "$EXPECTED_SHA_MPIP"
stat "$MPIP_LIB" | tee "$EVIDENCE/mpiP.stat.txt"
sha256sum "$MPIP_LIB" | tee "$EVIDENCE/mpiP.sha256"
echo 'CHECKPOINT_RUNTIME_LIBRARIES_OK'

test -d "$OF_DIR"
test -r "$OF_DIR/etc/bashrc"
cd "$OF_DIR"
echo 'CHECKPOINT_OPENFOAM_TREE_OK'

set +eu
. etc/bashrc WM_COMPILER=Amd WM_MPLIB=SYSTEMOPENMPI WM_COMPILE_OPTION=Opt WM_LABEL_SIZE=32
bashrc_rc=$?
# OpenFOAM's sourced tools and functions intentionally probe optional
# variables. Keep nounset disabled while restoring errexit and pipefail.
set -e
printf 'bashrc_rc=%s\n' "$bashrc_rc" | tee "$EVIDENCE/bashrc-status.txt"

test -n "${WM_PROJECT_DIR:-}" || { echo 'ERROR: WM_PROJECT_DIR is unset' >&2; exit 4; }
test -n "${FOAM_APPBIN:-}" || { echo 'ERROR: FOAM_APPBIN is unset' >&2; exit 4; }
test -n "${WM_PROJECT_VERSION:-}" || { echo 'ERROR: WM_PROJECT_VERSION is unset' >&2; exit 4; }
test -n "${WM_COMPILER:-}" || { echo 'ERROR: WM_COMPILER is unset' >&2; exit 4; }
test -n "${WM_OPTIONS:-}" || { echo 'ERROR: WM_OPTIONS is unset' >&2; exit 4; }
test -n "${WM_MPLIB:-}" || { echo 'ERROR: WM_MPLIB is unset' >&2; exit 4; }
test -n "${FOAM_MPI:-}" || { echo 'ERROR: FOAM_MPI is unset' >&2; exit 4; }
test -r "$WM_PROJECT_DIR/bin/tools/RunFunctions" || {
    echo 'ERROR: RunFunctions is unavailable' >&2
    exit 4
}
echo 'CHECKPOINT_FOAM_ENV_OK'

set +e
. "$WM_PROJECT_DIR/bin/tools/RunFunctions"
runfunctions_rc=$?
set -e
printf 'runfunctions_rc=%s\n' "$runfunctions_rc" | tee "$EVIDENCE/runfunctions-status.txt"
test "$(type -t restore0Dir)" = function || {
    echo 'ERROR: restore0Dir function is unavailable' >&2
    exit 4
}
echo 'CHECKPOINT_RUNFUNCTIONS_OK'

export LD_LIBRARY_PATH="${FOAM_EXTRA_LD_LIBRARY_PATH}:${LD_LIBRARY_PATH:-}"
SIMPLEFOAM="${FOAM_APPBIN}/simpleFoam"
test -x "$SIMPLEFOAM" || { echo "ERROR: simpleFoam is not executable: $SIMPLEFOAM" >&2; exit 4; }
test "$(sha256sum "$SIMPLEFOAM" | awk '{print $1}')" = "$EXPECTED_SHA_SIMPLEFOAM"
command -v mpirun decomposePar foamDictionary nm | tee "$EVIDENCE/executables.txt"
clang --version | head -n 1 | tee "$EVIDENCE/clang.version"
mpirun --version | head -n 3 | tee "$EVIDENCE/mpirun.version"
printf 'WM_PROJECT_VERSION=%s\nWM_COMPILER=%s\nWM_OPTIONS=%s\nWM_MPLIB=%s\nFOAM_MPI=%s\n' \
    "$WM_PROJECT_VERSION" "$WM_COMPILER" "$WM_OPTIONS" "$WM_MPLIB" "$FOAM_MPI" \
    | tee "$EVIDENCE/foam-env.txt"
sha256sum "$SIMPLEFOAM" | tee "$EVIDENCE/simpleFoam.sha256"

ldd "$SIMPLEFOAM" | tee "$EVIDENCE/simpleFoam.ldd"
ldd "$MPIP_LIB" | tee "$EVIDENCE/mpiP.ldd"
ldd "$FABRIC_LIB" | tee "$EVIDENCE/libfabric.ldd"
! grep -Fq 'not found' "$EVIDENCE/simpleFoam.ldd"
! grep -Fq 'not found' "$EVIDENCE/mpiP.ldd"
! grep -Fq 'not found' "$EVIDENCE/libfabric.ldd"
grep -Fq 'libmpi.so.40 => /app/apps/openmpi/5.0.10-gcc11/' "$EVIDENCE/simpleFoam.ldd"
grep -Fq 'libmpi.so.40 => /app/apps/openmpi/5.0.10-gcc11/' "$EVIDENCE/mpiP.ldd"
for linkage_file in "$EVIDENCE/simpleFoam.ldd" "$EVIDENCE/mpiP.ldd"; do
    resolved_fabric=$(awk '$1 == "libfabric.so.1" && $2 == "=>" {print $3; exit}' "$linkage_file")
    test -r "$resolved_fabric"
    test "$(readlink -f "$resolved_fabric")" = "$(readlink -f "$FABRIC_LIB")"
done
nm -D "$MPIP_LIB" | tee "$EVIDENCE/mpiP.nm-D.txt" >/dev/null
for symbol in MPI_Init MPI_Finalize MPI_Allreduce MPI_Waitall MPI_Isend MPI_Send; do
    grep -Eq " T ${symbol}$" "$EVIDENCE/mpiP.nm-D.txt"
done
echo 'CHECKPOINT_LINKAGE_AND_MPIP_OK'

ompi_info --param coll all --level 9 > "$EVIDENCE/ompi-coll.txt" 2>&1
ompi_info --param pml all --level 9 > "$EVIDENCE/ompi-pml.txt" 2>&1
lscpu > "$EVIDENCE/lscpu.txt"
numactl -H > "$EVIDENCE/numactl-H.txt" 2>&1 || true

echo '===== SOURCE WORKLOAD HASH GATE ====='
TEMPLATE=$(readlink -f "$TEMPLATE_LINK")
test -d "$TEMPLATE/constant/polyMesh"
cat > "$EVIDENCE/expected-source.sha256" <<SHAEOF
${EXPECTED_SHA_CASEDEF}  ${TEMPLATE}/system/include/caseDefinition
${EXPECTED_SHA_DECOMPOSE}  ${TEMPLATE}/system/decomposeParDict
${EXPECTED_SHA_CONTROL_NOWRITE}  ${TEMPLATE}/system/controlDict.noWrite
${EXPECTED_SHA_FVSCHEMES}  ${TEMPLATE}/system/fvSchemes
${EXPECTED_SHA_FVSOLUTION_FIXED}  ${TEMPLATE}/system/fvSolution.fixedIter
${EXPECTED_SHA_FORCECOEFFS}  ${TEMPLATE}/system/forceCoeffsAll
${EXPECTED_SHA_U}  ${TEMPLATE}/0.orig/U
${EXPECTED_SHA_TRANSPORT}  ${TEMPLATE}/constant/transportProperties
${EXPECTED_SHA_TURBULENCE}  ${TEMPLATE}/constant/turbulenceProperties
${EXPECTED_SHA_POINTS}  ${TEMPLATE}/constant/polyMesh/points
${EXPECTED_SHA_FACES}  ${TEMPLATE}/constant/polyMesh/faces
${EXPECTED_SHA_OWNER}  ${TEMPLATE}/constant/polyMesh/owner
${EXPECTED_SHA_NEIGHBOUR}  ${TEMPLATE}/constant/polyMesh/neighbour
${EXPECTED_SHA_BOUNDARY}  ${TEMPLATE}/constant/polyMesh/boundary
SHAEOF
sha256sum -c "$EVIDENCE/expected-source.sha256"

echo '===== FRESH CASE ====='
# Copy only scientific inputs. Exclude completed logs, processor directories,
# time directories and postProcessing from the template.
cp -a "$TEMPLATE/0.orig" "$TEMPLATE/constant" "$TEMPLATE/system" "$CASE/"
cd "$CASE"
test ! -e postProcessing
test ! -e logFiles
! find . -maxdepth 1 -type d -name 'processor*' | grep -q .
numeric_top=$(find . -maxdepth 1 -type d -printf '%f\n' | grep -E '^[0-9]+([.][0-9]+)?$' || true)
test -z "$numeric_top"

cp system/controlDict.noWrite system/controlDict
cp system/fvSolution.fixedIter system/fvSolution
foamDictionary -entry nCores -set "$NRANKS" system/include/caseDefinition
foamDictionary -entry nHierarchical -set '(8 8 8)' system/include/caseDefinition
foamDictionary -entry decompositionMethod -set kahip system/include/caseDefinition
foamDictionary -entry endTime -set "$ENDTIME" system/controlDict

test "$(foamDictionary -entry nCores -value system/include/caseDefinition | tr -d ' ')" = "$NRANKS"
test "$(foamDictionary -entry decompositionMethod -value system/include/caseDefinition | tr -d ' ')" = kahip
test "$(foamDictionary -entry endTime -value system/controlDict | tr -d ' ')" = "$ENDTIME"
cmp -s system/fvSolution system/fvSolution.fixedIter
sha256sum system/controlDict system/decomposeParDict system/include/caseDefinition \
    system/fvSchemes system/fvSolution system/forceCoeffsAll 0.orig/U \
    constant/transportProperties constant/turbulenceProperties \
    | tee "$EVIDENCE/effective-inputs.sha256"

echo '===== LAUNCHER / AFFINITY ====='
XENV_ARGS=(-x PATH -x LD_LIBRARY_PATH -x HOME)
while IFS= read -r variable; do
    XENV_ARGS+=(-x "$variable")
done < <(env | awk -F= '/^(WM_|FOAM_|LLVM_|GCOV_)/ {print $1}' | sort -u)
PAREX=(mpirun --hostfile "$PBS_NODEFILE" -np "$NRANKS" "${XENV_ARGS[@]}" \
    --bind-to core --map-by ppr:128:node:PE=1)
printf '%q ' "${PAREX[@]}" > "$EVIDENCE/launcher-control.txt"
printf '\n' >> "$EVIDENCE/launcher-control.txt"
printf 'LD_PRELOAD=%q MPIP=%q ' "$MPIP_LIB" '-k 3' > "$EVIDENCE/launcher-profile.txt"
printf '%q ' "${PAREX[@]}" -x LD_PRELOAD -x MPIP simpleFoam -parallel \
    >> "$EVIDENCE/launcher-profile.txt"
printf '\n' >> "$EVIDENCE/launcher-profile.txt"

"${PAREX[@]}" bash -c '
mask=$(awk "/Cpus_allowed_list/{print \$2}" /proc/self/status)
cpu=$(ps -o psr= -p $$ | tr -d " ")
socket=$(cat /sys/devices/system/cpu/cpu${cpu}/topology/physical_package_id)
core=$(cat /sys/devices/system/cpu/cpu${cpu}/topology/core_id)
nd=$(ls -d /sys/devices/system/cpu/cpu${cpu}/node* 2>/dev/null | head -n1)
printf "%s,%s,%s,%s,%s,%s,%s\n" "$OMPI_COMM_WORLD_RANK" "$OMPI_COMM_WORLD_LOCAL_RANK" "$(hostname -s)" "$mask" "$cpu" "$socket" "${nd##*node}:$core"
' | sort -t, -k1,1n > "$EVIDENCE/rank-affinity.csv"
test "$(wc -l < "$EVIDENCE/rank-affinity.csv" | tr -d ' ')" -eq "$NRANKS"
test "$(cut -d, -f3 "$EVIDENCE/rank-affinity.csv" | sort -u | wc -l | tr -d ' ')" -eq "$NNODES"
test "$(awk -F, '$4 ~ /,/ || $4 ~ /-/ {n++} END {print n+0}' "$EVIDENCE/rank-affinity.csv")" -eq 0

echo '===== ONE FRESH PARTITION SHARED BY ALL ARMS ====='
mkdir -p "$EVIDENCE/logs"
decomposePar -constant > "$EVIDENCE/logs/10_decomposePar.log" 2>&1
test "$(find . -maxdepth 1 -type d -name 'processor*' | wc -l | tr -d ' ')" -eq "$NRANKS"
sha256sum processor*/constant/polyMesh/boundary > "$EVIDENCE/partition-boundary.sha256"
sha256sum "$EVIDENCE/logs/10_decomposePar.log" > "$EVIDENCE/decompose-log.sha256"
restore0Dir -processor
"${PAREX[@]}" renumberMesh -constant -overwrite -parallel > "$EVIDENCE/logs/20_renumberMesh.log" 2>&1

prepare_fields()
{
    label=$1
    restore0Dir -processor
    unexpected_times=$(find processor* -mindepth 1 -maxdepth 1 -type d -printf '%f\n' \
        | grep -E '^[0-9]+([.][0-9]+)?$' | grep -v '^0$' || true)
    test -z "$unexpected_times"
    "${PAREX[@]}" potentialFoam -initialiseUBCs -parallel > "$EVIDENCE/logs/30_potentialFoam_${label}.log" 2>&1
    "${PAREX[@]}" applyBoundaryLayer -ybl 0.0450244 -parallel > "$EVIDENCE/logs/40_applyBoundaryLayer_${label}.log" 2>&1
}

extract_timing()
{
    label=$1
    log=$2
    csv="$EVIDENCE/execution-time-${label}.csv"
    summary="$EVIDENCE/steady-window-${label}.txt"
    awk '/^Time = / {step=$3} /^ExecutionTime = / {print step "," $3}' "$log" > "$csv"
    awk -F, -v label="$label" '
        $1 >= 19 && $1 <= 40 {t[$1]=$2}
        END {
            for (i=20; i<=40; i++) {
                if (!(i in t) || !((i-1) in t)) exit 2
                delta=t[i]-t[i-1]
                sum+=delta
                n++
            }
            if (n != 21) exit 3
            printf "label=%s\nwindow=steps20-40\nincrements=%d\nmean_s_per_step=%.12f\n", label, n, sum/n
        }
    ' "$csv" | tee "$summary"
}

validate_mpip_report()
{
    local report=$1
    local expected_ranks=$2
    for section in '@ mpiP' '@--- MPI Time (seconds)' \
        '@--- Aggregate Time (top twenty,' '@--- Callsite Time statistics' \
        '@--- End of Report'; do
        grep -aFq "$section" "$report" || {
            printf 'ERROR: mpiP report is missing section: %s\n' "$section" >&2
            return 1
        }
    done
    # mpiP's own headings include additional qualifiers. Validate the
    # structure and rank coverage rather than a truncated literal title.
    awk -v expected="$expected_ranks" '
        /^@ MPI Task Assignment[[:space:]]*:/ {
            rank=$6
            if (rank !~ /^[0-9]+$/ || rank < 0 || rank >= expected || rank in assigned) bad=1
            assigned[rank]=1
            assignments++
        }
        /^@--- MPI Time [(]seconds[)]/ {in_times=1; next}
        /^@---/ {in_times=0}
        in_times && NF == 4 && $1 ~ /^[0-9]+$/ {
            rank=$1
            if (rank < 0 || rank >= expected || rank in timed) bad=1
            timed[rank]=1
            timings++
        }
        END {
            if (bad || assignments != expected || timings != expected) {
                printf "ERROR: mpiP rank coverage: assignments=%d timing_rows=%d expected=%d\n", assignments, timings, expected > "/dev/stderr"
                exit 1
            }
            for (i=0; i<expected; i++) {
                if (!(i in assigned) || !(i in timed)) exit 1
            }
        }
    ' "$report"
}

run_arm()
{
    label=$1
    mode=$2
    test ! -e postProcessing
    prepare_fields "$label"
    log="$EVIDENCE/logs/50_simpleFoam_${label}.log"

    if test "$mode" = profile; then
        test -z "${LD_PRELOAD:-}"
        test -z "${MPIP:-}"
        LD_PRELOAD="$MPIP_LIB" MPIP='-k 3' \
            "${PAREX[@]}" -x LD_PRELOAD -x MPIP simpleFoam -parallel > "$log" 2>&1
    else
        test "$mode" = control
        test -z "${LD_PRELOAD:-}"
        test -z "${MPIP:-}"
        "${PAREX[@]}" simpleFoam -parallel > "$log" 2>&1
    fi

    grep -aEq "^Time = ${ENDTIME}[[:space:]]*$" "$log"
    grep -aFq 'Finalising parallel run' "$log"
    grep -aEq '^End$' "$log"
    ! grep -aEqi '(^|[^[:alpha:]])(nan|inf)([^[:alpha:]]|$)|floating point|segmentation fault' "$log"

    mapfile -t cd_files < <(find postProcessing/forceCoeffsAll -type f -name coefficient.dat)
    test "${#cd_files[@]}" -eq 1
    cd_file=${cd_files[0]}
    cd_mtime=$(stat -c %Y "$cd_file")
    test "$cd_mtime" -ge "$JOB_START_EPOCH"
    awk '!/^#/ {n++; if (n==1) first=$1; last=$1} END {exit !(n==40 && first==1 && last==40)}' "$cd_file"
    cp -p "$cd_file" "$EVIDENCE/coefficient-${label}.dat"
    sha256sum "$EVIDENCE/coefficient-${label}.dat" > "$EVIDENCE/coefficient-${label}.sha256"
    stat -c 'path=%n size=%s mtime_epoch=%Y mtime=%y' "$EVIDENCE/coefficient-${label}.dat" \
        > "$EVIDENCE/coefficient-${label}.stat"
    grep -aE '^(Time = |[A-Za-z0-9_]+:  Solving for |time step continuity errors)' "$log" \
        > "$EVIDENCE/scientific-trajectory-${label}.txt"
    grep -a 'Average wall-clock time per time step' "$log" | tail -n 1 \
        | tee "$EVIDENCE/avg-step-${label}.txt"
    extract_timing "$label" "$log"
    mv postProcessing "$EVIDENCE/postProcessing-${label}"
    echo "ARM_${label}_OK"
}

echo '===== ARM A0: UNPROFILED CONTROL ====='
run_arm A0 control

echo '===== ARM P0: mpiP PROFILE ====='
run_arm P0 profile
mapfile -t mpip_reports < <(find "$CASE" -maxdepth 1 -type f -name '*.mpiP')
test "${#mpip_reports[@]}" -eq 1
mpip_report=${mpip_reports[0]}
test "$(stat -c %Y "$mpip_report")" -ge "$JOB_START_EPOCH"
grep -aFq 'mpiP V3.5.0' "$EVIDENCE/logs/50_simpleFoam_P0.log"
grep -aFq 'Storing mpiP output in' "$EVIDENCE/logs/50_simpleFoam_P0.log"
validate_mpip_report "$mpip_report" "$NRANKS"
mv "$mpip_report" "$EVIDENCE/"
MPIP_REPORT="$EVIDENCE/$(basename "$mpip_report")"
sha256sum "$MPIP_REPORT" | tee "$EVIDENCE/mpiP-report.sha256"
stat -c 'path=%n size=%s mtime_epoch=%Y mtime=%y' "$MPIP_REPORT" \
    | tee "$EVIDENCE/mpiP-report.stat"

echo '===== ARM A1: UNPROFILED CONTROL REPEAT ====='
run_arm A1 control

echo '===== CORRECTNESS / OVERHEAD COMPARISON ====='
sha256sum "$EVIDENCE/coefficient-A0.dat" "$EVIDENCE/coefficient-P0.dat" \
    "$EVIDENCE/coefficient-A1.dat" | tee "$EVIDENCE/coefficient-comparison.sha256"
cmp -s "$EVIDENCE/coefficient-A0.dat" "$EVIDENCE/coefficient-P0.dat"
cmp -s "$EVIDENCE/coefficient-A0.dat" "$EVIDENCE/coefficient-A1.dat"
printf 'coefficient_files_byte_identical=yes\n' > "$EVIDENCE/coefficient-comparison.txt"

cmp -s "$EVIDENCE/scientific-trajectory-A0.txt" "$EVIDENCE/scientific-trajectory-P0.txt"
cmp -s "$EVIDENCE/scientific-trajectory-A0.txt" "$EVIDENCE/scientific-trajectory-A1.txt"
printf 'scientific_trajectories_byte_identical=yes\n' > "$EVIDENCE/scientific-trajectory-comparison.txt"

a0=$(awk -F= '$1=="mean_s_per_step" {print $2}' "$EVIDENCE/steady-window-A0.txt")
p0=$(awk -F= '$1=="mean_s_per_step" {print $2}' "$EVIDENCE/steady-window-P0.txt")
a1=$(awk -F= '$1=="mean_s_per_step" {print $2}' "$EVIDENCE/steady-window-A1.txt")
awk -v a0="$a0" -v p0="$p0" -v a1="$a1" '
    BEGIN {
        control=(a0+a1)/2
        repeatability=100*((a0>a1 ? a0-a1 : a1-a0)/control)
        overhead=100*(p0/control-1)
        printf "A0_mean_s_per_step=%.12f\n", a0
        printf "P0_mean_s_per_step=%.12f\n", p0
        printf "A1_mean_s_per_step=%.12f\n", a1
        printf "control_pair_mean_s_per_step=%.12f\n", control
        printf "control_pair_difference_percent=%.6f\n", repeatability
        printf "mpiP_overhead_percent=%.6f\n", overhead
        if (repeatability > 1.0) exit 2
    }
' | tee "$EVIDENCE/timing-comparison.txt"

printf 'classification=PROFILING DIAGNOSTIC\nofficial_result=false\nprofiled=true\npbs_jobid=%s\nnodes=%s\nranks=%s\nranks_per_node=%s\ncompiler=AOCC 5.0\nmpi=Open MPI 5.0.10\ndecomposition=kahip fast imbalance 0.01\nendtime=%s\narm_A0=unprofiled control\narm_P0=mpiP 3.5 LD_PRELOAD profile\narm_A1=unprofiled control repeat\nmpiP_metric_scope=measured MPI time, not total application runtime\n' \
    "$PBS_JOBID" "$NNODES" "$NRANKS" "$RANKS_PER_NODE" "$ENDTIME" \
    > "$EVIDENCE/provenance.txt"
echo STEP3_CLEAN_MPIP_PASS
