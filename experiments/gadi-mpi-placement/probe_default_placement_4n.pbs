#!/bin/bash
# MPI PLACEMENT AUDIT -- diagnostic probe only. This is NOT a benchmark and
# produces no performance number. It runs no OpenFOAM solver.
#
# Purpose: establish the ACTUAL rank -> node -> socket -> NUMA -> core mapping
# for the same 4-node / 416-rank normalsr configuration used by the SPR
# benchmark, under the SAME launch policy (bare `mpirun -np 416`).
#
# The only flags added are reporting flags that do not alter placement:
#   --display-allocation  --display-map  --report-bindings
# Verified present in this OpenMPI build via `mpirun --help all` before writing.
#
# The module load is byte-identical to the benchmark's (`OpenFOAM/2512`, which
# itself loads openmpi/4.1.7) so the MCA environment is reproduced exactly.
#PBS -P pm78
#PBS -q normalsr
#PBS -N of2512_mpi_placement_probe
#PBS -l ncpus=416
#PBS -l mem=16GB
#PBS -l jobfs=1GB
#PBS -l walltime=00:03:00
#PBS -l storage=scratch/pm78
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/pm78/kj7183/openfoam_cpu/experiments/gadi-mpi-placement/submit-logs/of2512_mpi_placement_probe.pbs.out
set -euo pipefail

RUN_ROOT=/scratch/pm78/kj7183/openfoam_cpu/experiments/gadi-mpi-placement
EVIDENCE="${RUN_ROOT}/evidence/mpi-placement.${PBS_JOBID:?}"
NRANKS=416
NNODES=4
RANKS_PER_NODE=104

mkdir -p "$EVIDENCE"
exec > >(tee -a "${EVIDENCE}/run.log") 2>&1

preserve_evidence()
{
    rc=$?
    set +e
    printf 'script_exit_rc=%s\n' "$rc" > "${EVIDENCE}/exit-status.txt"
    return $rc
}
trap preserve_evidence EXIT

printf 'probe_kind=mpi-placement-audit\nofficial_result=false\nclassification=DIAGNOSTIC\n'
printf 'pbs_jobid=%s\n' "$PBS_JOBID"

# --------------------------------------------------------- environment gates
module purge
module load OpenFOAM/2512
module list 2>&1 | tee "${EVIDENCE}/modules.txt"

command -v mpirun | tee "${EVIDENCE}/mpirun.path"
mpirun --version 2>&1 | head -n 1 | tee "${EVIDENCE}/mpirun.version"
test "$(command -v mpirun)" = /apps/openmpi/4.1.7/bin/mpirun

# Node / allocation identity.
sort -u "$PBS_NODEFILE" | tee "${EVIDENCE}/nodes.txt"
test "$(sort -u "$PBS_NODEFILE" | wc -l)" -eq "$NNODES"
test "$(wc -l < "$PBS_NODEFILE")" -eq "$NRANKS"
cp -p "$PBS_NODEFILE" "${EVIDENCE}/pbs_nodefile.txt"

# Effective MCA policy AS SEEN ON THE COMPUTE NODE (not the login node).
ompi_info --param rmaps base --level 9 2>/dev/null \
    | grep -E 'mapping_policy|ranking_policy' > "${EVIDENCE}/mca-rmaps.txt" || true
ompi_info --param hwloc base --level 9 2>/dev/null \
    | grep -E 'binding_policy' > "${EVIDENCE}/mca-hwloc.txt" || true
cat "${EVIDENCE}/mca-rmaps.txt" "${EVIDENCE}/mca-hwloc.txt"

env | grep -E '^(OMPI_|PMIX_|PRTE_|UCX_|HCOLL_|UCC_)' | sort > "${EVIDENCE}/mpi-env.txt" || true

# Hardware topology of the head compute node.
lscpu > "${EVIDENCE}/lscpu.txt" 2>&1
grep -E 'Model name|Socket|Core|Thread|NUMA' "${EVIDENCE}/lscpu.txt"
numactl -H > "${EVIDENCE}/numactl-H.txt" 2>&1 || echo 'numactl -H unavailable'

# ------------------------------------------------- per-rank reporter (shared)
REPORTER="${EVIDENCE}/rank_report.sh"
cat > "$REPORTER" <<'RPT'
#!/bin/bash
# One line per rank. The affinity MASK is the authoritative binding evidence;
# the current CPU is merely where the process happens to be scheduled now.
mask=$(awk '/Cpus_allowed_list/{print $2}' /proc/self/status)
cpu=$(ps -o psr= -p $$ 2>/dev/null | tr -d ' ')
[ -n "$cpu" ] || cpu=$(awk '{print $39}' /proc/self/stat)
pkg=$(cat "/sys/devices/system/cpu/cpu${cpu}/topology/physical_package_id" 2>/dev/null || echo NA)
core=$(cat "/sys/devices/system/cpu/cpu${cpu}/topology/core_id" 2>/dev/null || echo NA)
nd=$(ls -d "/sys/devices/system/cpu/cpu${cpu}"/node* 2>/dev/null | head -n 1)
numa=NA; [ -n "$nd" ] && numa=$(basename "$nd"); numa=${numa#node}
ncpu=$(printf '%s' "$mask" | awk -F, '{n=0; for(i=1;i<=NF;i++){if($i ~ /-/){split($i,r,"-"); n+=r[2]-r[1]+1} else n++} print n}')
# The RANKINFO token makes these lines separable from mpirun's own
# --display-map / --display-allocation output, which also goes to stdout.
printf 'RANKINFO,%s,%s,%s,%s,%s,%s,%s,%s\n' \
    "${OMPI_COMM_WORLD_RANK}" "${OMPI_COMM_WORLD_LOCAL_RANK}" "$(hostname -s)" \
    "$mask" "$ncpu" "$cpu" "$pkg" "$numa"
RPT
chmod +x "$REPORTER"

# ------------------------------------------------------------------ the probe
# Bare `mpirun -np 416` -- exactly the benchmark's launch policy. The three
# added flags are reporting-only and documented not to change mapping/binding.
echo '===== MPIRUN ALLOCATION / MAP / BINDINGS ====='
mpirun -np "$NRANKS" \
    --display-allocation --display-map --report-bindings \
    "$REPORTER" \
    > "${EVIDENCE}/mpirun-stdout.txt" \
    2> "${EVIDENCE}/mpirun-map-bindings.txt"

# Separate the per-rank lines from mpirun's own map/allocation output.
grep '^RANKINFO,' "${EVIDENCE}/mpirun-stdout.txt" | cut -d, -f2- \
    | sort -t, -k1,1n > "${EVIDENCE}/rank-report.raw.csv"
{ echo 'rank,local_rank,host,cpus_allowed_list,n_cpus_in_mask,current_cpu,socket,numa'
  cat "${EVIDENCE}/rank-report.raw.csv"; } > "${EVIDENCE}/rank-report.csv"

# ------------------------------------------------------------------- gates
test "$(grep -c . "${EVIDENCE}/rank-report.raw.csv")" -eq "$NRANKS"
test "$(cut -d, -f3 "${EVIDENCE}/rank-report.raw.csv" | sort -u | wc -l)" -eq "$NNODES"
for h in $(cut -d, -f3 "${EVIDENCE}/rank-report.raw.csv" | sort -u); do
    n=$(cut -d, -f3 "${EVIDENCE}/rank-report.raw.csv" | grep -cx "$h")
    printf 'ranks_on_%s=%s\n' "$h" "$n"
    test "$n" -eq "$RANKS_PER_NODE"
done

echo '===== NODE-BOUNDARY RANKS ====='
head -n 1 "${EVIDENCE}/rank-report.csv"
for r in 0 103 104 207 208 311 312 415; do
    awk -F, -v r="$r" '$1==r' "${EVIDENCE}/rank-report.raw.csv"
done

echo '===== SUMMARY ====='
printf 'distinct_cpu_masks=%s\n' "$(cut -d, -f4 "${EVIDENCE}/rank-report.raw.csv" | sort -u | wc -l)"
printf 'mask_widths_seen=%s\n' "$(cut -d, -f5 "${EVIDENCE}/rank-report.raw.csv" | sort -un | tr '\n' ' ')"
printf 'oversubscribed_masks=%s\n' \
    "$(awk -F, '{print $3","$4}' "${EVIDENCE}/rank-report.raw.csv" | sort | uniq -d | wc -l)"

printf 'nodes=%s\nranks=%s\nranks_per_node=%s\n' "$NNODES" "$NRANKS" "$RANKS_PER_NODE" \
    > "${EVIDENCE}/provenance.txt"
echo MPI_PLACEMENT_PROBE_PASS
