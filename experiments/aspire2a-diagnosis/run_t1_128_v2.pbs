#!/bin/bash -l
# Purpose: T1 fresh-case 128-rank renumberMesh-only diagnostic after successful setup.
#PBS -N of2512_diag_t1_128v2
#PBS -P 59000020
#PBS -q normal
#PBS -l select=1:ncpus=128:mpiprocs=128:ompthreads=1:mem=440gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /home/project/59000020/openfoam-isc26/results/of2512_diag_t1_128_v2.out
set +e
. /app/apps/resetmodule
set -e
module load openfoam/2512
set -o pipefail
export OMP_NUM_THREADS=1
ulimit -s unlimited
CASE_DIR="/home/project/59000020/openfoam-isc26/diagnostic-t1-128-v2"
LOG_DIR="$CASE_DIR/logFiles"; RUN_TAG="t1-128-v2"; NPROCS=128; PPN=128
REN_LOG="$LOG_DIR/20_renumberMesh.${RUN_TAG}.log"; DIAG="$LOG_DIR/00_runtime.${RUN_TAG}.log"
test -n "${WM_PROJECT_DIR:-}"; . "$WM_PROJECT_DIR/bin/tools/RunFunctions"; set -u
test "$(type -t restore0Dir || true)" = function; test -d "$CASE_DIR"; test ! -e "$REN_LOG"
test "$(find "$CASE_DIR" -maxdepth 1 -type d -name 'processor*' | wc -l)" -eq "$NPROCS"
mkdir -p "$LOG_DIR"
{ echo "PBS_JOBID=${PBS_JOBID:-not-set}"; date; hostname; sort -u "$PBS_NODEFILE"; echo "slots=$(wc -l < "$PBS_NODEFILE")"; module list 2>&1; mpirun --version 2>&1; command -v renumberMesh; ulimit -a; ulimit -c; env | sort | grep -E '^(PBS|WM|FOAM|MPICH|PMI|PALS|CRAY|FI|OMP)_' | grep -viE '(PASS|TOKEN|KEY)' || true; echo "launch: mpirun -n $NPROCS --ppn $PPN --cpu-bind depth -d 1 renumberMesh -constant -overwrite -parallel"; } > "$DIAG" 2>&1
cd "$CASE_DIR"; restore0Dir -processor; set +e
time mpirun -n "$NPROCS" --ppn "$PPN" --cpu-bind depth -d 1 renumberMesh -constant -overwrite -parallel > "$REN_LOG" 2>&1
rc=$?; set -e; echo "launcher_exit_code=$rc" >> "$DIAG"; date >> "$DIAG"; exit "$rc"
