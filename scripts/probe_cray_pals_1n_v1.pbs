#!/bin/bash -l
# One-node PALS launch and Cray MPICH library availability probe.
# Run from the synchronized control repository; output goes to scripts/outputs/.
# This checks library resolution and launcher startup, not MPI_Init or OpenFOAM.
#PBS -N probe_cray_pals_1n_v1
#PBS -P 59000020
#PBS -q normal
#PBS -l select=1:ncpus=128:mpiprocs=2:ompthreads=1:mem=440gb
#PBS -l walltime=00:05:00
#PBS -o /home/project/59000020/openfoam-isc26/control-repo/scripts/outputs/probe_cray_pals_1n_v1.o
#PBS -e /home/project/59000020/openfoam-isc26/control-repo/scripts/outputs/probe_cray_pals_1n_v1.e

set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
module purge
module load aocc/5.0 gcc/11.2.0 cray-pals/1.1.6
MPICH_DIR=/opt/cray/pe/mpich/8.1.15/ofi/gnu/9.1
test -r "${MPICH_DIR}/lib/libmpi.so"
ldd "${MPICH_DIR}/lib/libmpi.so"
if ldd "${MPICH_DIR}/lib/libmpi.so" | grep -q 'not found'; then
    echo "Unresolved Cray MPICH dependency" >&2
    exit 2
fi
command -v mpiexec
mpiexec -n 2 --ppn 2 /bin/hostname
