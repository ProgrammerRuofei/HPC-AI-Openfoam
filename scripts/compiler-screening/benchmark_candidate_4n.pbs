#!/bin/bash
# Submit only after build and smoke pass. Runtime inputs are passed with qsub -v.
#PBS -P pm78
#PBS -q normal
#PBS -N drivaer_compiler_screen
#PBS -l ncpus=192
#PBS -l mem=760GB
#PBS -l jobfs=20GB
#PBS -l walltime=02:00:00
#PBS -l storage=scratch/pm78
#PBS -l wd
#PBS -j oe
set -euo pipefail
: "${STACK_ID:?}" "${RUN_TAG:?}" "${RUN_ROOT:?}" "${MODULE_LIST:?}" "${WM_COMPILER_VALUE:?}" "${RUNTIME_ARCHIVE:?}" "${RUNTIME_ARCHIVE_SHA256:?}" "${CANDIDATE_BINARY_REL:?}" "${CANDIDATE_BINARY_SHA256:?}"
module purge; module load ${MODULE_LIST}; export OMP_NUM_THREADS=1; ulimit -s unlimited
RUNTIME_ROOT="${PBS_JOBFS}/openfoam-runtime/${STACK_ID}"; export STACK_ID RUNTIME_ARCHIVE RUNTIME_ARCHIVE_SHA256 RUNTIME_ROOT CANDIDATE_BINARY_REL CANDIDATE_BINARY_SHA256
mkdir -p "${RUN_ROOT}/evidence/${RUN_TAG}.${PBS_JOBID}"
exec > >(tee -a "${RUN_ROOT}/evidence/${RUN_TAG}.${PBS_JOBID}/run.log") 2>&1
stage_report=$(pbsdsh -s -c "${PBS_NNODES:?}" -- bash scripts/compiler-screening/stage_candidate_runtime_node.sh | sort)
printf '%s\n' "$stage_report" | tee "${RUN_ROOT}/evidence/${RUN_TAG}.${PBS_JOBID}/runtime-nodes.txt"
test "$(printf '%s\n' "$stage_report" | grep -c '^runtime_stage_pass ' )" = "${PBS_NNODES:?}"
set +u; . "$RUNTIME_ROOT/etc/bashrc" "WM_COMPILER=${WM_COMPILER_VALUE}" WM_MPLIB=SYSTEMOPENMPI WM_COMPILE_OPTION=Opt; set -u
test "$FOAM_API" = 2512; test "$WM_MPLIB" = SYSTEMOPENMPI
case "$CANDIDATE_BINARY_REL" in "platforms/${WM_OPTIONS}/bin/simpleFoam") ;; *) echo 'ERROR: candidate binary/platform mismatch' >&2; exit 3;; esac
test "$(command -v mpirun)" = /apps/openmpi/4.1.7/bin/mpirun
test "$(command -v simpleFoam)" = "$RUNTIME_ROOT/$CANDIDATE_BINARY_REL"
test "$(sha256sum "$RUNTIME_ROOT/$CANDIDATE_BINARY_REL" | awk '{print $1}')" = "$CANDIDATE_BINARY_SHA256"
SOURCE_CASE=/scratch/pm78/kj7183/openfoam_cpu/case/occDrivAerStaticMesh
CASE="${RUN_ROOT}/case"; test ! -e "$CASE"; mkdir -p "$CASE"
cp -a "$SOURCE_CASE/0.orig" "$SOURCE_CASE/constant" "$SOURCE_CASE/system" "$SOURCE_CASE/Allrun.gadi" "$CASE/"
cd "$CASE"; grep -Eq '^[[:space:]]*nCores[[:space:]]+192;' system/include/caseDefinition; grep -Eq '^[[:space:]]*nHierarchical[[:space:]]+\(16 6 2\);' system/include/caseDefinition; grep -Eq '^[[:space:]]*endTime[[:space:]]+150;' system/controlDict.noWrite; cmp -s system/fvSolution system/fvSolution.fixedIter
sha256sum Allrun.gadi system/include/caseDefinition system/controlDict.noWrite system/fvSchemes system/fvSolution system/fvSolution.fixedIter | tee "${RUN_ROOT}/evidence/${RUN_TAG}.${PBS_JOBID}/case.sha256"
export EXPECTED_ENDTIME=150
bash ./Allrun.gadi
