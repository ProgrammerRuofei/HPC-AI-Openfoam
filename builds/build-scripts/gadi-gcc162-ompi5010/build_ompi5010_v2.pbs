#!/bin/bash
# Build Open MPI 5.0.10 with the validated GCC 16.2 archive on Gadi SPR.
# Submit from the synchronized control repository after review.
#PBS -P pm78
#PBS -q normalsr
#PBS -N of_ompi5010_v2
#PBS -l ncpus=32
#PBS -l mem=128GB
#PBS -l jobfs=30GB
#PBS -l walltime=02:00:00
#PBS -l storage=scratch/pm78
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/gadi-gcc162-ompi5010/submit-logs/build_ompi5010_v2.pbs.out
set -euo pipefail
cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is required}"
exec bash builds/build-scripts/gadi-gcc162-ompi5010/build_ompi5010_v2.sh
