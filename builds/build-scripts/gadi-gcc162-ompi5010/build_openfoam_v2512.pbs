#!/bin/bash
# Build stock OpenFOAM v2512 with the validated private GCC 16.2/Open MPI 5.0.10 stack on Gadi SPR.
#PBS -P pm78
#PBS -q normalsr
#PBS -N of2512_gcc162_ompi5010
#PBS -l ncpus=48
#PBS -l mem=190GB
#PBS -l jobfs=100GB
#PBS -l walltime=04:00:00
#PBS -l storage=scratch/pm78
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/gadi-gcc162-ompi5010/submit-logs/build_openfoam_v2512.pbs.out
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
exec bash builds/build-scripts/gadi-gcc162-ompi5010/build_openfoam_v2512.sh
