#!/bin/bash
# One-node diagnostic for the existing GCC 16.2/Open MPI 5.0.10 baseline stack.
# This is not a scored OpenFOAM run and does not alter the scientific case.
#PBS -P pm78
#PBS -q normalsr
#PBS -N gcc162_ucx_diag_1n
#PBS -l ncpus=4
#PBS -l mem=16GB
#PBS -l jobfs=12GB
#PBS -l walltime=00:10:00
#PBS -l storage=scratch/pm78
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/gadi-gcc162-ompi5010/submit-logs/diagnose_ucx_ucc_hpctoolkit_1n_v1.pbs.out
set -euo pipefail

STACK_ROOT=/scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/gadi-gcc162-ompi5010
OF_ROOT=/scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/gadi-gcc162-ompi5010-of2512
GCC_ARCHIVE="$STACK_ROOT/runtime-archive/gcc-16.2.0.181342083.gadi-pbs.tar.gz"
MPI_ARCHIVE="$STACK_ROOT/runtime-archive/openmpi-5.0.10.181346004.gadi-pbs.tar.gz"
OF_ARCHIVE="$OF_ROOT/runtime-archive/gadi-gcc162-ompi5010-of2512.181360543.gadi-pbs.tar.gz"
GCC_SHA=1149c0d97412ae3741cc18d60f233cdd3dd5e33bc92c55c59db2dd8cf535b714
MPI_SHA=8ac121e4f64eb329dc33cd2cc8229dc9f655064a757cbcaa36af962b21619fc6
OF_SHA=64cd075a385938f0c9ac0c478066349e5bb198f5fa8cd80cc3ed61fb12286281
BIN_SHA=b3b992619ea5b9805fe1c549d2dafafe6cba88411bd152f7b1eb50081fc867c5
ROOT="${PBS_JOBFS:?}/gcc162-ucx-diag-${PBS_JOBID:?}"
EVIDENCE="$OF_ROOT/evidence/ucx-ucc-diag.${PBS_JOBID}"
GCC_PREFIX="$ROOT/gcc-16.2.0"
MPI_PREFIX="$ROOT/openmpi-5.0.10"
FOAM_ROOT="$ROOT/OpenFOAM-v2512"
test "${PBS_NCPUS:?}" -eq 4
test ! -e "$ROOT"; test ! -e "$EVIDENCE"
for item in "$GCC_SHA $GCC_ARCHIVE" "$MPI_SHA $MPI_ARCHIVE" "$OF_SHA $OF_ARCHIVE"; do
    read -r hash file <<< "$item"
    printf '%s  %s\n' "$hash" "$file" | sha256sum -c -
done
mkdir -p "$ROOT" "$EVIDENCE"
exec > >(tee "$EVIDENCE/run.log") 2>&1
trap 'rc=$?; printf "pbs_script_rc=%s\n" "$rc" > "$EVIDENCE/exit-status.txt"' EXIT
printf 'diagnostic_only=true\njob_id=%s\n' "$PBS_JOBID" | tee "$EVIDENCE/provenance.txt"
module purge
module load ucx/1.18.1 ucc/1.4.4
module list 2>&1 | tee "$EVIDENCE/modules.txt"
test "${UCX_ROOT:?}" = /apps/ucx/1.18.1
test "${UCC_ROOT:?}" = /apps/ucc/1.4.4
tar -xzf "$GCC_ARCHIVE" -C "$ROOT"
tar -xzf "$MPI_ARCHIVE" -C "$ROOT"
tar -xzf "$OF_ARCHIVE" -C "$ROOT"
export OPAL_PREFIX="$MPI_PREFIX" PMIX_PREFIX="$MPI_PREFIX" PRTE_PREFIX="$MPI_PREFIX"
export OMPI_CC="$GCC_PREFIX/bin/gcc" OMPI_CXX="$GCC_PREFIX/bin/g++"
export PATH="$MPI_PREFIX/bin:$GCC_PREFIX/bin:$PATH"
export LD_LIBRARY_PATH="$MPI_PREFIX/lib:$GCC_PREFIX/lib64:/opt/pbs/default/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
gcc --version | head -n 1 | grep -Fx 'gcc (GCC) 16.2.0'
mpirun --version | head -n 1 | grep -Fx 'mpirun (Open MPI) 5.0.10'
BIN="$FOAM_ROOT/platforms/linux64GccDPInt32Opt/bin/simpleFoam"
printf '%s  %s\n' "$BIN_SHA" "$BIN" | sha256sum -c -
set +u
. "$FOAM_ROOT/etc/bashrc" WM_COMPILER=Gcc WM_MPLIB=SYSTEMOPENMPI WM_COMPILE_OPTION=Opt
set -u
test "$WM_PROJECT_DIR" = "$FOAM_ROOT"
test "$(command -v mpicc)" = "$MPI_PREFIX/bin/mpicc"
printf 'LD_LIBRARY_PATH=%s\n' "$LD_LIBRARY_PATH" > "$EVIDENCE/ld-library-path.txt"
ldd "$BIN" | tee "$EVIDENCE/simpleFoam.ldd"
! grep -Fq 'not found' "$EVIDENCE/simpleFoam.ldd"
grep -F "libmpi.so.40 => $MPI_PREFIX/lib/" "$EVIDENCE/simpleFoam.ldd"
grep -F 'libucc.so.1 => /apps/ucc/1.4.4/lib/' "$EVIDENCE/simpleFoam.ldd"
sha256sum /apps/ucc/1.4.4/lib/libucc.so.1 | tee "$EVIDENCE/ucc.sha256"
ompi_info --all --param coll ucc --level 9 > "$EVIDENCE/coll-ucc-info.txt"
ompi_info --param pml ucx > "$EVIDENCE/pml-ucx-info.txt"

cat > "$ROOT/ucx-diag.c" <<'C_EOF'
#define _GNU_SOURCE
#include <mpi.h>
#include <dlfcn.h>
#include <link.h>
#include <sched.h>
#include <stdio.h>
#include <string.h>
#include <unistd.h>

static char ucp_path[4096];
static int locate_ucp(struct dl_phdr_info *info, size_t size, void *data) {
    (void)size; (void)data;
    if (info->dlpi_name && strstr(info->dlpi_name, "libucp.so")) {
        snprintf(ucp_path, sizeof(ucp_path), "%s", info->dlpi_name);
        return 1;
    }
    return 0;
}
int main(int argc, char **argv) {
    int rank, n, sum;
    char host[256] = {0};
    cpu_set_t cpus;
    MPI_Init(&argc, &argv);
    MPI_Comm_rank(MPI_COMM_WORLD, &rank);
    MPI_Comm_size(MPI_COMM_WORLD, &n);
    MPI_Allreduce(&rank, &sum, 1, MPI_INT, MPI_SUM, MPI_COMM_WORLD);
    MPI_Barrier(MPI_COMM_WORLD);
    dl_iterate_phdr(locate_ucp, NULL);
    void *handle = ucp_path[0] ? dlopen(ucp_path, RTLD_NOW | RTLD_NOLOAD) : NULL;
    const char *(*version)(void) = handle ? dlsym(handle, "ucp_get_version_string") : NULL;
    gethostname(host, sizeof(host) - 1);
    CPU_ZERO(&cpus);
    int affinity_ok = sched_getaffinity(0, sizeof(cpus), &cpus) == 0;
    printf("UCX_DIAG rank=%d size=%d host=%s cpu=%d allowed_cpus=%d path=%s version=%s allreduce=%d\n",
           rank, n, host, sched_getcpu(), affinity_ok ? CPU_COUNT(&cpus) : -1,
           ucp_path[0] ? ucp_path : "MISSING", version ? version() : "MISSING", sum);
    fflush(stdout);
    if (handle) dlclose(handle);
    MPI_Finalize();
    return n == 2 && sum == 1 && ucp_path[0] && version && affinity_ok ? 0 : 1;
}
C_EOF
mpicc "$ROOT/ucx-diag.c" -ldl -o "$ROOT/ucx-diag"
ldd "$ROOT/ucx-diag" | tee "$EVIDENCE/ucx-diag.ldd"
! grep -Fq 'not found' "$EVIDENCE/ucx-diag.ldd"
mpirun --mca pml ucx --mca coll_base_verbose 20 -np 2 "$ROOT/ucx-diag" > "$EVIDENCE/mpi-runtime.txt" 2>&1
grep -F 'UCX_DIAG rank=0 size=2' "$EVIDENCE/mpi-runtime.txt"
grep -F 'UCX_DIAG rank=1 size=2' "$EVIDENCE/mpi-runtime.txt"
awk '/UCX_DIAG/ {for (i=1;i<=NF;i++) if ($i ~ /^path=/) {sub(/^path=/,"",$i); print $i}}' "$EVIDENCE/mpi-runtime.txt" | sort -u > "$EVIDENCE/ucp-paths.txt"
test "$(wc -l < "$EVIDENCE/ucp-paths.txt")" -eq 1
while IFS= read -r path; do test -f "$path"; sha256sum "$path"; done < "$EVIDENCE/ucp-paths.txt" | tee "$EVIDENCE/ucp.sha256"

# A two-rank profiler compatibility test; results stay diagnostic only.
mpirun --mca pml ucx -np 2 /bin/bash -c '
    exec /apps/hpctoolkit/2021.05.15/bin/hpcrun -e CPUTIME@f20 \
        -o "$1/hpctoolkit-rank-${OMPI_COMM_WORLD_RANK:?}" "$1/ucx-diag"
' _ "$ROOT" > "$EVIDENCE/hpctoolkit-smoke.log" 2>&1
test -d "$ROOT/hpctoolkit-rank-0"; test -d "$ROOT/hpctoolkit-rank-1"
tar -czf "$EVIDENCE/hpctoolkit-smoke.tar.gz" -C "$ROOT" hpctoolkit-rank-0 hpctoolkit-rank-1
echo UCX_UCC_HPCTOOLKIT_1N_DIAG_PASS
