#!/bin/bash
# Analyze the archived five-rank HPCToolkit smoke on one SPR compute node.
# Submit from the Gadi control repo. Inputs are immutable runtime/profile archives;
# output is one job-keyed database archive and logs, never a scored run.
#PBS -P pm78
#PBS -q normalsr
#PBS -N gcc162_hpc_postproc
#PBS -l ncpus=2
#PBS -l mem=16GB
#PBS -l jobfs=20GB
#PBS -l walltime=00:10:00
#PBS -l storage=scratch/pm78
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/gadi-gcc162-ompi5010/submit-logs/postprocess_hpctoolkit_smoke_1n_v1.pbs.out
set -euo pipefail

STACK_ROOT=/scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/gadi-gcc162-ompi5010
OF_ROOT=/scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/gadi-gcc162-ompi5010-of2512
INPUT="$OF_ROOT/evidence/hpctoolkit-openfoam-smoke.181585812.gadi-pbs"
GCC_ARCHIVE="$STACK_ROOT/runtime-archive/gcc-16.2.0.181342083.gadi-pbs.tar.gz"
MPI_ARCHIVE="$STACK_ROOT/runtime-archive/openmpi-5.0.10.181346004.gadi-pbs.tar.gz"
OF_ARCHIVE="$OF_ROOT/runtime-archive/gadi-gcc162-ompi5010-of2512.181360543.gadi-pbs.tar.gz"
GCC_SHA=1149c0d97412ae3741cc18d60f233cdd3dd5e33bc92c55c59db2dd8cf535b714
MPI_SHA=8ac121e4f64eb329dc33cd2cc8229dc9f655064a757cbcaa36af962b21619fc6
OF_SHA=64cd075a385938f0c9ac0c478066349e5bb198f5fa8cd80cc3ed61fb12286281
PROFILE_SHA=c9fef4adf1b3a19126688c6602277d593981875f5efab4c31dbf7d131020ead0
BIN_SHA=b3b992619ea5b9805fe1c549d2dafafe6cba88411bd152f7b1eb50081fc867c5
ROOT="${PBS_JOBFS:?}/gcc162-hpctoolkit-postprocess-${PBS_JOBID:?}"
EVIDENCE="$OF_ROOT/evidence/hpctoolkit-postprocess.${PBS_JOBID}"
TOOL=/apps/hpctoolkit/2021.05.15/bin
OLD_ROOT=/jobfs/181585812.gadi-pbs/gcc162-hpctoolkit-openfoam-181585812.gadi-pbs
FOAM_ROOT="$ROOT/OpenFOAM-v2512"
BIN="$FOAM_ROOT/platforms/linux64GccDPInt32Opt/bin/simpleFoam"

test "${PBS_NNODES:?}" -eq 1
test "${PBS_NCPUS:?}" -eq 2
test ! -e "$ROOT"; test ! -e "$EVIDENCE"
test -x "$TOOL/hpcstruct"; test -x "$TOOL/hpcprof"
command -v timeout
for item in "$GCC_SHA $GCC_ARCHIVE" "$MPI_SHA $MPI_ARCHIVE" "$OF_SHA $OF_ARCHIVE" \
    "$PROFILE_SHA $INPUT/hpctoolkit-measurements.tar.gz"; do
    read -r hash file <<< "$item"
    printf '%s  %s\n' "$hash" "$file" | sha256sum -c -
done
mkdir -p "$ROOT" "$EVIDENCE"
exec > >(tee "$EVIDENCE/run.log") 2>&1
preserve() {
    rc=$?; set +e
    printf 'script_exit_rc=%s\n' "$rc" > "$EVIDENCE/exit-status.txt"
    return "$rc"
}
trap preserve EXIT

printf 'source_job=181585812.gadi-pbs\nprofile_type=diagnostic-not-scored\n' > "$EVIDENCE/provenance.txt"
tar -xzf "$GCC_ARCHIVE" -C "$ROOT"
tar -xzf "$MPI_ARCHIVE" -C "$ROOT"
tar -xzf "$OF_ARCHIVE" -C "$ROOT"
tar -xzf "$INPUT/hpctoolkit-measurements.tar.gz" -C "$ROOT"
printf '%s  %s\n' "$BIN_SHA" "$BIN" | sha256sum -c -
for rank in 1 2 3 4; do
    test "$(find "$ROOT/profiles/rank-$rank" -type f -name 'simpleFoam*.hpcrun' -size +0c | wc -l)" -ge 1
done

if timeout -k 5s 180s "$TOOL/hpcstruct" -j 2 -o "$ROOT/simpleFoam.hpcstruct" "$BIN" > "$EVIDENCE/hpcstruct.log" 2>&1 \
    && test -s "$ROOT/simpleFoam.hpcstruct"; then
    struct_args=(-S "$ROOT/simpleFoam.hpcstruct")
    printf 'hpcstruct=pass\n' >> "$EVIDENCE/provenance.txt"
else
    struct_args=()
    printf 'hpcstruct=failed-or-timed-out\n' >> "$EVIDENCE/provenance.txt"
fi
timeout -k 5s 180s "$TOOL/hpcprof" -M stats \
    -R "$OLD_ROOT=$ROOT" -I "$FOAM_ROOT/+" "${struct_args[@]}" \
    -o "$ROOT/hpcprof-db" "$ROOT"/profiles/rank-{1,2,3,4} \
    > "$EVIDENCE/hpcprof.log" 2>&1
test -s "$ROOT/hpcprof-db/experiment.xml"
tar -czf "$EVIDENCE/hpcprof-db.tar.gz" -C "$ROOT" hpcprof-db
test -s "$EVIDENCE/hpcprof-db.tar.gz"
sha256sum "$EVIDENCE/hpcprof-db.tar.gz" > "$EVIDENCE/hpcprof-db.sha256"
printf 'database_bytes=%s\n' "$(stat -c %s "$EVIDENCE/hpcprof-db.tar.gz")" >> "$EVIDENCE/provenance.txt"
echo HPCTOOLKIT_SMOKE_POSTPROCESS_1N_PASS
