#!/bin/bash
# Rebuild OpenFOAM v2512 with GCC 16.2 and a real Scotch 6.1.0 library.
#PBS -P pm78
#PBS -q normalsr
#PBS -N of2512_scotch_gcc162
#PBS -l ncpus=48
#PBS -l mem=190GB
#PBS -l jobfs=100GB
#PBS -l walltime=04:00:00
#PBS -l storage=scratch/pm78
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/gadi-gcc162-ompi5010/submit-logs/build_openfoam_v2512_scotch_v2.pbs.out
