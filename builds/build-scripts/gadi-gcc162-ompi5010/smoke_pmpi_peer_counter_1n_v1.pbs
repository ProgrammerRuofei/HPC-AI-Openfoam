#!/bin/bash
# C-only PMPI peer-counter smoke; one node, never a scored science run.
#PBS -P pm78
#PBS -q normalsr
#PBS -N gcc162_pmpi_peer
#PBS -l ncpus=5
#PBS -l mem=16GB
#PBS -l jobfs=20GB
#PBS -l walltime=00:15:00
#PBS -l storage=scratch/pm78
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/gadi-gcc162-ompi5010/submit-logs/smoke_pmpi_peer_counter_1n_v1.pbs.out
set -euo pipefail

STACK_ROOT=/scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/gadi-gcc162-ompi5010
OF_ROOT=/scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/gadi-gcc162-ompi5010-of2512
SOURCE="$STACK_ROOT/submit-logs/pmpi_peer_counter_v1.submitted.c"
SOURCE_SHA=ae997a4b1c51884b0954470ebf7ffb62b254741a86d1e4c0b9f1f3ca6feaa974
GCC_ARCHIVE="$STACK_ROOT/runtime-archive/gcc-16.2.0.181342083.gadi-pbs.tar.gz"
MPI_ARCHIVE="$STACK_ROOT/runtime-archive/openmpi-5.0.10.181346004.gadi-pbs.tar.gz"
OF_ARCHIVE="$OF_ROOT/runtime-archive/gadi-gcc162-ompi5010-of2512.181360543.gadi-pbs.tar.gz"
GCC_SHA=1149c0d97412ae3741cc18d60f233cdd3dd5e33bc92c55c59db2dd8cf535b714
MPI_SHA=8ac121e4f64eb329dc33cd2cc8229dc9f655064a757cbcaa36af962b21619fc6
OF_SHA=64cd075a385938f0c9ac0c478066349e5bb198f5fa8cd80cc3ed61fb12286281
BIN_SHA=b3b992619ea5b9805fe1c549d2dafafe6cba88411bd152f7b1eb50081fc867c5
FO_FILE=/scratch/pm78/kj7183/openfoam_cpu/case/occDrivAerStaticMesh/system/FOwallClockTimeStatistics
FO_SHA=0a0e5d072527bc1e67e5bc505da30bec0abebc67262aa47ecaece4d13b2ece08
ROOT="${PBS_JOBFS:?}/gcc162-pmpi-peer-v1-${PBS_JOBID:?}"
EVIDENCE="$OF_ROOT/evidence/pmpi-peer-v1-smoke.${PBS_JOBID}"
GCC_PREFIX="$ROOT/gcc-16.2.0"
MPI_PREFIX="$ROOT/openmpi-5.0.10"
FOAM_ROOT="$ROOT/OpenFOAM-v2512"
CASE="$ROOT/pitzDaily_fused"
LIB="$ROOT/libpmpi_peer_counter.so"

test "${PBS_NNODES:?}" -eq 1
test "${PBS_NCPUS:?}" -eq 5
test ! -e "$ROOT"; test ! -e "$EVIDENCE"
command -v timeout
for item in "$SOURCE_SHA $SOURCE" "$GCC_SHA $GCC_ARCHIVE" "$MPI_SHA $MPI_ARCHIVE" "$OF_SHA $OF_ARCHIVE" "$FO_SHA $FO_FILE"; do
    read -r hash file <<< "$item"
    printf '%s  %s\n' "$hash" "$file" | sha256sum -c -
done
mkdir -p "$ROOT" "$EVIDENCE" "$EVIDENCE/probe-reports" "$EVIDENCE/tutorial-P1-reports" "$EVIDENCE/tutorial-P2-reports"
exec > >(tee "$EVIDENCE/run.log") 2>&1
preserve() {
    rc=$?; set +e
    for file in "$ROOT"/tutorial-*/log.simpleFoam; do
        test ! -f "$file" || cp -p "$file" "$EVIDENCE/$(basename "$(dirname "$file")").log.simpleFoam"
    done
    printf 'script_exit_rc=%s\n' "$rc" > "$EVIDENCE/exit-status.txt"
    return "$rc"
}
trap preserve EXIT

module purge
module load ucx/1.18.1 ucc/1.4.4
module list 2>&1 | tee "$EVIDENCE/modules.txt"
test "${UCX_ROOT:?}" = /apps/ucx/1.18.1
test "${UCC_ROOT:?}" = /apps/ucc/1.4.4
tar -xzf "$GCC_ARCHIVE" -C "$ROOT"
tar -xzf "$MPI_ARCHIVE" -C "$ROOT"
tar -xzf "$OF_ARCHIVE" -C "$ROOT"
export OPAL_PREFIX="$MPI_PREFIX" PMIX_PREFIX="$MPI_PREFIX" PRTE_PREFIX="$MPI_PREFIX"
export OMPI_CC="$GCC_PREFIX/bin/gcc" OMPI_CXX="$GCC_PREFIX/bin/g++"
export PATH="$MPI_PREFIX/bin:$GCC_PREFIX/bin:$PATH"
export LD_LIBRARY_PATH="$MPI_PREFIX/lib:$GCC_PREFIX/lib64:/opt/pbs/default/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
gcc --version | head -n 1 | grep -Fx 'gcc (GCC) 16.2.0'
mpirun --version | head -n 1 | grep -Fx 'mpirun (Open MPI) 5.0.10'
mpicc --showme:command | grep -Fx "$GCC_PREFIX/bin/gcc"
mpicc -O2 -g -std=gnu17 -Wall -Wextra -Werror -fPIC -shared "$SOURCE" -o "$LIB" \
    > "$EVIDENCE/build.log" 2>&1
test -s "$LIB"
ldd "$LIB" | tee "$EVIDENCE/pmpi_peer_counter.ldd"
! grep -Fq 'not found' "$EVIDENCE/pmpi_peer_counter.ldd"
grep -F "libmpi.so.40 => $MPI_PREFIX/lib/" "$EVIDENCE/pmpi_peer_counter.ldd"
cp -p "$LIB" "$EVIDENCE/"
sha256sum "$EVIDENCE/libpmpi_peer_counter.so" > "$EVIDENCE/libpmpi_peer_counter.sha256"
sha256sum -c "$EVIDENCE/libpmpi_peer_counter.sha256"

cat > "$ROOT/mpi_probe.c" <<'PROBE'
#include <mpi.h>
#include <stdio.h>
int main(int argc, char **argv) {
    int rank, peer, sum, sbuf[5] = {1,2,3,4,5}, rbuf[5] = {0};
    MPI_Request requests[2];
    MPI_Comm duplicate;
    MPI_Init(&argc, &argv);
    MPI_Comm_rank(MPI_COMM_WORLD, &rank);
    if (rank > 1) { MPI_Finalize(); return 3; }
    peer = 1-rank;
    MPI_Isend(sbuf, rank == 0 ? 4 : 3, MPI_INT, peer, 10, MPI_COMM_WORLD, &requests[0]);
    MPI_Irecv(rbuf, rank == 0 ? 3 : 4, MPI_INT, peer, 10, MPI_COMM_WORLD, &requests[1]);
    MPI_Waitall(2, requests, MPI_STATUSES_IGNORE);
    if (rank == 0) {
        MPI_Send(sbuf, 2, MPI_INT, 1, 11, MPI_COMM_WORLD);
        MPI_Recv(rbuf, 1, MPI_INT, 1, 12, MPI_COMM_WORLD, MPI_STATUS_IGNORE);
    } else {
        MPI_Recv(rbuf, 2, MPI_INT, 0, 11, MPI_COMM_WORLD, MPI_STATUS_IGNORE);
        MPI_Send(sbuf, 1, MPI_INT, 0, 12, MPI_COMM_WORLD);
    }
    MPI_Sendrecv(sbuf, 5, MPI_INT, peer, 13, rbuf, 5, MPI_INT,
                 peer, 13, MPI_COMM_WORLD, MPI_STATUS_IGNORE);
    MPI_Comm_dup(MPI_COMM_WORLD, &duplicate);
    MPI_Sendrecv(sbuf, 1, MPI_INT, peer, 14, rbuf, 1, MPI_INT,
                 peer, 14, duplicate, MPI_STATUS_IGNORE);
    MPI_Comm_free(&duplicate);
    MPI_Allreduce(&rank, &sum, 1, MPI_INT, MPI_SUM, MPI_COMM_WORLD);
    MPI_Barrier(MPI_COMM_WORLD);
    if (rank == 0 && sum == 1) puts("MPI_PEER_PROBE_PASS");
    MPI_Finalize();
    return sum == 1 ? 0 : 4;
}
PROBE
mpicc -O2 -Wall -Wextra -Werror "$ROOT/mpi_probe.c" -o "$ROOT/mpi_probe"
ldd "$ROOT/mpi_probe" | tee "$EVIDENCE/mpi_probe.ldd"
grep -F "libmpi.so.40 => $MPI_PREFIX/lib/" "$EVIDENCE/mpi_probe.ldd"
timeout -k 5s 45s mpirun --mca pml ucx -np 2 /usr/bin/env \
    LD_PRELOAD="$LIB" PMPI_TIMING_DIR="$EVIDENCE/probe-reports" \
    "$ROOT/mpi_probe" > "$EVIDENCE/mpi_probe.log" 2>&1
grep -Fq MPI_PEER_PROBE_PASS "$EVIDENCE/mpi_probe.log"

/bin/python3 - "$EVIDENCE/probe-reports" <<'CHECK_PROBE'
import csv, pathlib, sys
base = pathlib.Path(sys.argv[1])
expected = {
    "MPI_Isend": (4, 3),
    "MPI_Irecv": (3, 4),
    "MPI_Send": (2, 1),
    "MPI_Recv": (1, 2),
    "MPI_Sendrecv_send": (5, 5),
    "MPI_Sendrecv_recv": (5, 5),
}
for rank in range(2):
    path = base / f"rank-{rank:06d}-peers.csv"
    rows = list(csv.DictReader(path.open(newline="")))
    world = {r["call"]: r for r in rows if r["peer_scope"] == "world"}
    other = {r["call"]: r for r in rows if r["peer_scope"] == "other_comm"}
    assert set(world) == set(expected), (rank, world)
    assert set(other) == {"MPI_Sendrecv_send", "MPI_Sendrecv_recv"}, (rank, other)
    assert all(int(r["peer"]) == 1-rank for r in world.values())
    for call, sizes in expected.items():
        row = world[call]
        assert int(row["count"]) == 1, (rank, call, row)
        assert int(row["requested_bytes"]) == 4*sizes[rank], (rank, call, row)
        assert int(row["size_errors"]) == 0, (rank, call, row)
    assert all(int(r["count"]) == 1 and int(r["requested_bytes"]) == 4
               and int(r["size_errors"]) == 0 for r in other.values())
    assert not any(r["peer_scope"] == "unresolved_world_peer" for r in rows)
print("PMPI_PEER_PROBE_REPORT_PASS")
CHECK_PROBE

BIN="$FOAM_ROOT/platforms/linux64GccDPInt32Opt/bin/simpleFoam"
test -x "$BIN"
printf '%s  %s\n' "$BIN_SHA" "$BIN" | sha256sum -c -
set +u
. "$FOAM_ROOT/etc/bashrc" WM_COMPILER=Gcc WM_MPLIB=SYSTEMOPENMPI WM_COMPILE_OPTION=Opt
set -u
test "$WM_OPTIONS" = linux64GccDPInt32Opt
test "$(command -v mpicc)" = "$MPI_PREFIX/bin/mpicc"
ldd "$BIN" | tee "$EVIDENCE/simpleFoam.ldd"
! grep -Fq 'not found' "$EVIDENCE/simpleFoam.ldd"
grep -F "libmpi.so.40 => $MPI_PREFIX/lib/" "$EVIDENCE/simpleFoam.ldd"
cp -a /apps/OpenFOAM/2512/tutorials/incompressible/simpleFoam/pitzDaily_fused "$CASE"
cd "$CASE"
cp -p "$FO_FILE" system/FOwallClockTimeStatistics
sed -i -E 's/^(method[[:space:]]+)hierarchical;/\1scotch;/' system/decomposeParDict
grep -Eq '^method[[:space:]]+scotch;' system/decomposeParDict
printf '\nfunctions\n{\n    #include "FOwallClockTimeStatistics"\n}\n' >> system/controlDict
sed -i -E 's/^(endTime[[:space:]]+)[0-9]+;/\120;/' system/controlDict
blockMesh > "$EVIDENCE/blockMesh.log" 2>&1
decomposePar > "$EVIDENCE/decomposePar.log" 2>&1
grep -Eiq 'scotch|finished decomposition' "$EVIDENCE/decomposePar.log"
printf 'label\telapsed_ns\n' > "$EVIDENCE/solver-walltime.tsv"
for label in U1 P1 U2 P2; do
    run_case="$ROOT/tutorial-$label"
    cp -a "$CASE" "$run_case"
    mkdir -p "$EVIDENCE/tutorial-$label-reports"
    cd "$run_case"
    begin_ns=$(date +%s%N)
    if [[ "$label" == P* ]]; then
        timeout -k 5s 90s mpirun --mca pml ucx -np 5 /usr/bin/env \
            LD_PRELOAD="$LIB" PMPI_TIMING_DIR="$EVIDENCE/tutorial-$label-reports" \
            "$BIN" -parallel > log.simpleFoam 2>&1
    else
        timeout -k 5s 90s mpirun --mca pml ucx -np 5 "$BIN" -parallel > log.simpleFoam 2>&1
    fi
    elapsed_ns=$(( $(date +%s%N) - begin_ns ))
    printf '%s\t%s\n' "$label" "$elapsed_ns" >> "$EVIDENCE/solver-walltime.tsv"
    cp -p log.simpleFoam "$EVIDENCE/tutorial-$label.log.simpleFoam"
    grep -Fq 'Finalising parallel run' log.simpleFoam
    grep -Fq 'Average wall-clock time per time step' log.simpleFoam
    grep -aEq '^End$' log.simpleFoam
    if grep -Eq 'FOAM FATAL|MPI_ABORT|Segmentation fault' log.simpleFoam; then exit 8; fi
done

/bin/python3 - "$EVIDENCE" <<'CHECK_TUTORIAL'
import csv, pathlib, re, statistics, sys
base = pathlib.Path(sys.argv[1])
for label in ("P1", "P2"):
    folder = base / f"tutorial-{label}-reports"
    summaries = sorted(folder.glob("rank-??????.csv"))
    buckets = sorted(folder.glob("rank-??????-buckets.csv"))
    peers = sorted(folder.glob("rank-??????-peers.csv"))
    assert len(summaries) == len(buckets) == len(peers) == 5, label
    scope_counts = {"world": 0, "other_comm": 0, "unresolved_world_peer": 0}
    for rank in range(5):
        stem = f"rank-{rank:06d}"
        with (folder / f"{stem}.csv").open(newline="") as stream:
            totals = {row["call"]: int(row["count"]) for row in csv.DictReader(stream)}
        with (folder / f"{stem}-peers.csv").open(newline="") as stream:
            peer_rows = list(csv.DictReader(stream))
        assert all(int(row["rank"]) == rank for row in peer_rows)
        assert all(int(row["size_errors"]) == 0 for row in peer_rows)
        for row in peer_rows:
            scope_counts[row["peer_scope"]] += int(row["count"])
        for call in ("MPI_Isend", "MPI_Irecv", "MPI_Send", "MPI_Recv"):
            seen = sum(int(row["count"]) for row in peer_rows if row["call"] == call)
            assert 0 <= seen <= totals[call], (label, rank, call, seen, totals[call])
        for call in ("MPI_Sendrecv_send", "MPI_Sendrecv_recv"):
            seen = sum(int(row["count"]) for row in peer_rows if row["call"] == call)
            assert 0 <= seen <= totals["MPI_Sendrecv"], (label, rank, call)
    assert scope_counts["world"] > 0, (label, scope_counts)
    print("PMPI_PEER_TUTORIAL_REPORT_PASS", label, scope_counts)
with (base / "solver-walltime.tsv").open(newline="") as stream:
    times = {row["label"]: int(row["elapsed_ns"]) for row in csv.DictReader(stream, delimiter="\t")}
assert set(times) == {"U1", "P1", "U2", "P2"}, times
plain = statistics.mean((times["U1"], times["U2"]))
instrumented = statistics.mean((times["P1"], times["P2"]))
ratio = instrumented / plain
print(f"PMPI_PEER_OVERHEAD_RATIO={ratio:.6f}")
steps = {}
for label in times:
    data = (base / f"tutorial-{label}.log.simpleFoam").read_text(errors="replace")
    matches = re.findall(r"Average wall-clock time per time step[^\n]*?([0-9]+(?:\.[0-9]+)?)\s*$", data, re.M)
    assert matches, label
    steps[label] = float(matches[-1])
step_ratio = statistics.mean((steps["P1"], steps["P2"])) / statistics.mean((steps["U1"], steps["U2"]))
print(f"PMPI_PEER_SOLVER_STEP_RATIO={step_ratio:.6f}")
with (base / "overhead-summary.txt").open("w") as stream:
    stream.write(f"unprofiled_mean_ns={plain:.0f}\nprofiled_mean_ns={instrumented:.0f}\nratio={ratio:.6f}\n")
    for label in sorted(steps):
        stream.write(f"{label}_seconds_per_step={steps[label]:.9f}\n")
    stream.write(f"solver_step_ratio={step_ratio:.6f}\n")
CHECK_TUTORIAL
printf 'official_result=false\nsource=C-only-PMPI-peer-counter-v1\nranks=2+5\ndecomposition=scotch\nsolver_steps=20\n' > "$EVIDENCE/provenance.txt"
echo GCC162_OMPI5010_PMPI_PEER_V1_1N_SMOKE_PASS
