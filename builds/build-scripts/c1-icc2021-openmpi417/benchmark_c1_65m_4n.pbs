#!/bin/bash
# C1 (ICC 2021.10 + OpenMPI 4.1.7) 65M DrivAer screening benchmark, 4 nodes.
#
# This is a Cascade Lake `normal` screening run, NOT an official competition
# result: official results are produced on `normalsr` Sapphire Rapids. Its
# purpose is to obtain the first C1 ClockTime / average step time under the
# same workload identity as the Phase 0 R1-R4 baseline repeats.
#
# Do not qsub before: (a) the control repo on Gadi is synchronised and this
# file's commit is recorded, and (b) the persistent submit-logs directory below
# already exists -- PBS discards job output if the -o directory is missing.
#PBS -P pm78
#PBS -q normal
#PBS -N of2512_c1_65m_4n
#PBS -l ncpus=192
#PBS -l mem=760GB
#PBS -l jobfs=40GB
#PBS -l walltime=00:40:00
#PBS -l storage=scratch/pm78
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/c1-icc2021-openmpi417/benchmark-65m-4n/submit-logs/of2512_c1_65m_4n.pbs.out
set -euo pipefail

# ---------------------------------------------------------------- pinned inputs
CONTROL_REPO=/scratch/pm78/kj7183/openfoam_cpu/control-repo
STAGE_HELPER="${CONTROL_REPO}/builds/build-scripts/c1-icc2021-openmpi417/stage_c1_runtime_node.sh"

# C1 runtime-v2 archive and simpleFoam, both already validated by
# C1_RUNTIME_ARCHIVE_V2_PASS and C1_RUNTIME_SMOKE_PASS.
ARCHIVE=/scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/c1-icc2021-openmpi417/runtime-archive/c1-icc2021-openmpi417.178166771.gadi-pbs.runtime-v2.tar.gz
EXPECTED_ARCHIVE_SHA256=16f5836b3084a284eb67e5e560d5ca245c29be14febec036b2e7f0cf7f4dc7eb
EXPECTED_BINARY_SHA256=73a3260e2dfec970a9b76de990983fffd4ed8a47363aa497a89560f5c684533d
BINARY_REL=platforms/linux64IccDPInt32Opt/bin/simpleFoam

# Precompiled ICC dynamicCode library for the workload's wallClockTimeStatistics
# coded functionObject, built once by prepare_c1_wallclock_dynamiccode.pbs
# (job 178568099) and validated by smoke_c1_dynamiccode.pbs (job 178568271).
# Without it OpenFOAM tries to JIT-compile the functionObject on all 192 ranks
# and deadlocks, which is how job 178564210 was lost. The SHA1 in the filename
# hashes the functionObject text, so it is identical to the GCC baseline's.
DYNCODE_SHA1=6e8d888ad28997c1bc9eebd1c08a1a15774516a4
DYNCODE_LIB="libwallClockTimeStatistics_${DYNCODE_SHA1}.so"
DYNCODE_ARTIFACT="/scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/c1-icc2021-openmpi417/dynamiccode-artifact/${DYNCODE_LIB}"
EXPECTED_DYNCODE_SHA256=e772e9d2af426f4d3997b88d07ea8f06c95b16b89efb0cb6d5ec9604c95a211b
DYNCODE_CASE_REL="dynamicCode/platforms/linux64IccDPInt32Opt/lib"

# Authoritative 65M workload identity, recovered from the Phase 0 R1-R4 raw
# evidence and identical across all four repeats. fvSolution and
# fvSolution.fixedIter share a hash because the baseline protocol requires the
# fixed-iteration solution to be the active one.
EXPECTED_SHA_ALLRUN=2a02ec456ce880b2242d566da6c5b28fae1aa99218169260030cd53f5a662ec3
EXPECTED_SHA_CASEDEF=1da44731f5f723c1b8471bee6c6186c6f402f63154f84cacd26bf27e30e6a6c6
EXPECTED_SHA_CONTROLDICT_NOWRITE=ce4ec0f52bcc88eea8402b454940dc5aad1f31dea6441e7d98413b651427ef06
EXPECTED_SHA_FVSCHEMES=064bb50455d37a7edd2c0fb24bbe30baaf851623f0250d550450c10e407889b3
EXPECTED_SHA_FVSOLUTION=5e1db8548ee82c44f8fa3377a80971af2b5aabb95b3ee7efcd8b723c5dcab1ba
EXPECTED_SHA_FVSOLUTION_FIXEDITER=5e1db8548ee82c44f8fa3377a80971af2b5aabb95b3ee7efcd8b723c5dcab1ba

# Hard configuration contract for this screening point.
EXPECTED_NODES=4
EXPECTED_RANKS=192
EXPECTED_RANKS_PER_NODE=48
EXPECTED_ENDTIME=150

SOURCE_CASE=/scratch/pm78/kj7183/openfoam_cpu/case/occDrivAerStaticMesh
RUN_ROOT=/scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/c1-icc2021-openmpi417/benchmark-65m-4n
RUN_TAG=c1-icc2021-openmpi417-65m-4n-192r
CASE="${RUN_ROOT}/case"
EVIDENCE="${RUN_ROOT}/evidence/${RUN_TAG}.${PBS_JOBID:?}"

RUNTIME_CONTAINER="${PBS_JOBFS:?}/c1-65m-runtime"
RUNTIME_ROOT="${RUNTIME_CONTAINER}/OpenFOAM-v2512"
THIRDPARTY_ROOT="${RUNTIME_CONTAINER}/ThirdParty-v2512"
CANDIDATE_SIMPLEFOAM="${RUNTIME_ROOT}/${BINARY_REL}"

test ! -e "$CASE"
mkdir -p "$EVIDENCE"
exec > >(tee -a "$EVIDENCE/run.log") 2>&1

# A failed or truncated run is exactly the one whose solver log and force
# coefficients are most needed, so evidence is preserved unconditionally.
preserve_evidence()
{
    status=$?
    set +e
    for log in 10_decomposePar.log 20_renumberMesh.log 30_potentialFoam.log 40_applyBoundaryLayer.log; do
        test -f "${CASE}/logFiles/${log}" && cp -p "${CASE}/logFiles/${log}" "$EVIDENCE/"
    done
    for solver in "${CASE}"/logFiles/50_simpleFoam.*.log; do
        test -f "$solver" && cp -p "$solver" "$EVIDENCE/"
    done
    coeff=$(find "${CASE}/postProcessing/forceCoeffsAll" -name coefficient.dat -type f 2>/dev/null | head -n 1)
    test -n "$coeff" && cp -f "$coeff" "$EVIDENCE/coefficient.dat"
    printf 'pbs_exit_status=%s\n' "$status" > "$EVIDENCE/exit-status.txt"
    exit "$status"
}
trap preserve_evidence EXIT

# ------------------------------------------------------- allocation hard gates
echo '===== ALLOCATION GATES ====='
printf 'run_tag=%s\npbs_jobid=%s\nscreening_only=true\nofficial_result=false\n' "$RUN_TAG" "$PBS_JOBID"
sort -u "$PBS_NODEFILE" | tee "$EVIDENCE/nodes.txt"
allocated_nodes=$(sort -u "$PBS_NODEFILE" | wc -l | tr -d ' ')
allocated_slots=$(wc -l < "$PBS_NODEFILE" | tr -d ' ')
slots_per_node=$(awk '{c[$0]++} END {for (h in c) print c[h]}' "$PBS_NODEFILE" | sort -u)
printf 'allocated_nodes=%s\nallocated_slots=%s\nslots_per_node=%s\npbs_ncpus=%s\n' \
    "$allocated_nodes" "$allocated_slots" "$slots_per_node" "${PBS_NCPUS:?}"
test "$allocated_nodes" -eq "$EXPECTED_NODES"
test "$allocated_slots" -eq "$EXPECTED_RANKS"
test "$PBS_NCPUS" -eq "$EXPECTED_RANKS"
test "$slots_per_node" = "$EXPECTED_RANKS_PER_NODE"
lscpu | grep -E 'Model name|Socket\(s\)|Core\(s\) per socket|Thread\(s\) per core|^CPU\(s\)' | tee "$EVIDENCE/lscpu.txt"

# ------------------------------------------------ toolchain / MPI provenance
echo '===== TOOLCHAIN PROVENANCE ====='
module purge
module load intel-compiler/2021.10.0 openmpi/4.1.7
module list 2>&1 | tee "$EVIDENCE/modules.txt"
grep -Fq 'intel-compiler/2021.10.0' "$EVIDENCE/modules.txt"
grep -Fq 'openmpi/4.1.7' "$EVIDENCE/modules.txt"
# Reject any Intel MPI contamination: no intel-mpi module, no I_MPI_* variable.
if grep -Eqi 'intel-mpi|impi' "$EVIDENCE/modules.txt"; then
    echo 'ERROR: Intel MPI module present in a SYSTEMOPENMPI run' >&2; exit 7
fi
# The intel-compiler module legitimately exports I_MPI_CC/CXX/F77/F90 as wrapper
# *compiler hints*; their presence does not imply Intel MPI is loaded. Job
# 178563232 exited 7 on the former, over-broad '^I_MPI_' test. Every I_MPI_*
# variable is now recorded as provenance and NONE is fatal on its own: Intel MPI
# contamination is decided by the concrete module, launcher-path, launcher-version
# and ldd checks, which remain fatal. A stale or compiler-exported environment
# variable must never fail this run by itself.
env | grep '^I_MPI_' | sort | tee "$EVIDENCE/i_mpi_vars.txt" || true
if env | grep -q '^I_MPI_ROOT='; then
    printf 'ADVISORY: I_MPI_ROOT is set (%s). Not fatal by itself; the module, mpirun path/version and ldd checks below decide.\n' "$(printenv I_MPI_ROOT)"
fi
command -v mpirun | tee "$EVIDENCE/mpirun.path"
mpirun --version > "$EVIDENCE/mpirun.version" 2>&1; cat "$EVIDENCE/mpirun.version"
command -v mpicc | tee "$EVIDENCE/mpicc.path"
test "$(command -v mpirun)" = /apps/openmpi/4.1.7/bin/mpirun
test "$(command -v mpicc)" = /apps/openmpi/4.1.7/bin/mpicc
grep -Fq 'Open MPI) 4.1.7' "$EVIDENCE/mpirun.version"
icc --version > "$EVIDENCE/icc.version" 2>&1; cat "$EVIDENCE/icc.version"
grep -Fq '2021.10.0' "$EVIDENCE/icc.version"

export OMP_NUM_THREADS=1
export EXPECTED_ENDTIME
ulimit -s unlimited

# --------------------------------------------------- per-node runtime staging
echo '===== RUNTIME STAGING ====='
cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is required}"
test "$PBS_O_WORKDIR" = "$CONTROL_REPO"
test -r "$STAGE_HELPER"
# One staging task per node, launched through the same OpenMPI that will run
# the solver. PBS_NNODES is a Torque variable and is not defined by PBS Pro on
# Gadi, so the node count is taken from PBS_NODEFILE and re-verified from the
# per-node pass lines below.
mpirun -np "$EXPECTED_NODES" --map-by ppr:1:node /bin/bash "$STAGE_HELPER" \
    "$ARCHIVE" "$EXPECTED_ARCHIVE_SHA256" "$RUNTIME_CONTAINER" \
    "$BINARY_REL" "$EXPECTED_BINARY_SHA256" | sort | tee "$EVIDENCE/runtime-nodes.txt"
test "$(grep -c '^runtime_stage_pass ' "$EVIDENCE/runtime-nodes.txt")" -eq "$EXPECTED_NODES"
test "$(awk '/^runtime_stage_pass /{print $2}' "$EVIDENCE/runtime-nodes.txt" | sort -u | wc -l)" -eq "$EXPECTED_NODES"

# ------------------------------------------------- OpenFOAM environment gates
echo '===== OPENFOAM ENVIRONMENT GATES ====='
set +u
. "$RUNTIME_ROOT/etc/bashrc" WM_COMPILER=Icc WM_MPLIB=SYSTEMOPENMPI WM_COMPILE_OPTION=Opt
set -u
printf 'WM_PROJECT_VERSION=%s\nWM_OPTIONS=%s\nWM_MPLIB=%s\nFOAM_MPI=%s\nWM_PROJECT_DIR=%s\nWM_THIRD_PARTY_DIR=%s\n' \
    "$WM_PROJECT_VERSION" "$WM_OPTIONS" "$WM_MPLIB" "$FOAM_MPI" "$WM_PROJECT_DIR" "$WM_THIRD_PARTY_DIR" \
    | tee "$EVIDENCE/foam-env.txt"
test "$WM_PROJECT_VERSION" = v2512
test "$WM_MPLIB" = SYSTEMOPENMPI
test "$WM_OPTIONS" = linux64IccDPInt32Opt
test "$FOAM_MPI" = sys-openmpi
test "$WM_PROJECT_DIR" = "$RUNTIME_ROOT"
test "$WM_THIRD_PARTY_DIR" = "$THIRDPARTY_ROOT"
test -x "$CANDIDATE_SIMPLEFOAM"
test "$(command -v simpleFoam)" = "$CANDIDATE_SIMPLEFOAM"
test "$(realpath "$(command -v simpleFoam)")" = "$(realpath "$CANDIDATE_SIMPLEFOAM")"
case "$(command -v simpleFoam)" in /apps/OpenFOAM/2512/*) echo 'ERROR: site simpleFoam fallback' >&2; exit 6;; esac
test "$(sha256sum "$CANDIDATE_SIMPLEFOAM" | awk '{print $1}')" = "$EXPECTED_BINARY_SHA256"

echo '===== LINKAGE ISOLATION ====='
file "$CANDIDATE_SIMPLEFOAM" | tee "$EVIDENCE/simpleFoam.file"
ldd "$CANDIDATE_SIMPLEFOAM" | tee "$EVIDENCE/simpleFoam.ldd"
! grep -q 'not found' "$EVIDENCE/simpleFoam.ldd"
grep -Fq "libOpenFOAM.so => ${RUNTIME_ROOT}/platforms/linux64IccDPInt32Opt/lib/" "$EVIDENCE/simpleFoam.ldd"
grep -Fq "libPstream.so => ${RUNTIME_ROOT}/platforms/linux64IccDPInt32Opt/lib/sys-openmpi/" "$EVIDENCE/simpleFoam.ldd"
grep -Fq 'libmpi.so.40 => /apps/openmpi/4.1.7/' "$EVIDENCE/simpleFoam.ldd"
# Site-install isolation and Intel MPI rejection at the linkage level.
! grep -Fq '/apps/OpenFOAM/2512/' "$EVIDENCE/simpleFoam.ldd"
! grep -Eqi 'intel-mpi|/impi|libmpi\.so\.12|libmpicxx' "$EVIDENCE/simpleFoam.ldd"

# ------------------------------------------------------- rank placement probe
echo '===== RANK PLACEMENT PROBE ====='
# Allrun.gadi launches a bare `mpirun -np <nCores>`; this probe exercises the
# identical mapping so a wrong placement fails here rather than mid-benchmark.
mpirun -np "$EXPECTED_RANKS" bash -c \
    'printf "rank=%s size=%s node=%s\n" "$OMPI_COMM_WORLD_RANK" "$OMPI_COMM_WORLD_SIZE" "$(hostname)"' \
    | sort > "$EVIDENCE/rank-launch.txt"
test "$(grep -c '^rank=' "$EVIDENCE/rank-launch.txt")" -eq "$EXPECTED_RANKS"
test "$(awk -F'[ =]' '/^rank=/{print $4}' "$EVIDENCE/rank-launch.txt" | sort -u)" = "$EXPECTED_RANKS"
probe_nodes=$(awk -F'node=' '/^rank=/{print $2}' "$EVIDENCE/rank-launch.txt" | sort -u | wc -l | tr -d ' ')
probe_per_node=$(awk -F'node=' '/^rank=/{print $2}' "$EVIDENCE/rank-launch.txt" | sort | uniq -c | awk '{print $1}' | sort -u)
printf 'probe_nodes=%s\nprobe_ranks_per_node=%s\n' "$probe_nodes" "$probe_per_node"
test "$probe_nodes" -eq "$EXPECTED_NODES"
test "$probe_per_node" = "$EXPECTED_RANKS_PER_NODE"

# ---------------------------------------------------- workload identity gates
echo '===== WORKLOAD IDENTITY GATES ====='
test -d "$SOURCE_CASE"
mkdir -p "$CASE"
# Deliberately copied: baseline initial state, mesh, dictionaries, launcher.
# Excluded: source 0/, old time directories, logFiles/, postProcessing/,
# dynamicCode/, and every processor* directory.
cp -a "$SOURCE_CASE/0.orig" "$SOURCE_CASE/constant" "$SOURCE_CASE/system" \
    "$SOURCE_CASE/Allrun.gadi" "$CASE/"
cd "$CASE"

cat > "$EVIDENCE/expected-workload.sha256" <<SHAEOF
${EXPECTED_SHA_ALLRUN}  Allrun.gadi
${EXPECTED_SHA_CASEDEF}  system/include/caseDefinition
${EXPECTED_SHA_CONTROLDICT_NOWRITE}  system/controlDict.noWrite
${EXPECTED_SHA_FVSCHEMES}  system/fvSchemes
${EXPECTED_SHA_FVSOLUTION}  system/fvSolution
${EXPECTED_SHA_FVSOLUTION_FIXEDITER}  system/fvSolution.fixedIter
SHAEOF
sha256sum -c "$EVIDENCE/expected-workload.sha256"
sha256sum Allrun.gadi system/include/caseDefinition system/controlDict.noWrite \
    system/fvSchemes system/fvSolution system/fvSolution.fixedIter \
    | tee "$EVIDENCE/observed-workload.sha256"

# Redundant, human-readable confirmation of the settings the hashes already pin.
grep -E 'nCores|decompositionMethod|nHierarchical' system/include/caseDefinition | tee "$EVIDENCE/decomposition.txt"
grep -Eq "^[[:space:]]*nCores[[:space:]]+${EXPECTED_RANKS};" system/include/caseDefinition
grep -Eq '^[[:space:]]*nHierarchical[[:space:]]+\(16 6 2\);' system/include/caseDefinition
grep -Eq "^[[:space:]]*endTime[[:space:]]+${EXPECTED_ENDTIME};" system/controlDict.noWrite
cmp -s system/fvSolution system/fvSolution.fixedIter
test -f constant/polyMesh/points
test -x Allrun.gadi
if find . -maxdepth 1 -type d -name 'processor*' | grep -q .; then
    echo 'ERROR: fresh case unexpectedly contains processor state' >&2; exit 1
fi

# --------------------------------------------- precompiled dynamicCode library
# The workload's controlDict, functionObject text and the six authoritative
# workload files are NOT modified. This only places the already-compiled ICC
# library where OpenFOAM looks for it, so it loads instead of invoking wmake.
echo '===== STAGING PRECOMPILED dynamicCode LIBRARY ====='
test -r "$DYNCODE_ARTIFACT"
printf '%s  %s\n' "$EXPECTED_DYNCODE_SHA256" "$DYNCODE_ARTIFACT" | sha256sum -c -
mkdir -p "$DYNCODE_CASE_REL"
cp -p "$DYNCODE_ARTIFACT" "${DYNCODE_CASE_REL}/${DYNCODE_LIB}"
test "$(sha256sum "${DYNCODE_CASE_REL}/${DYNCODE_LIB}" | awk '{print $1}')" = "$EXPECTED_DYNCODE_SHA256"
ls -la "$DYNCODE_CASE_REL" | tee "$EVIDENCE/dyncode-staged.txt"
printf 'dyncode_lib=%s\ndyncode_sha256=%s\ndyncode_sha1=%s\n' \
    "${DYNCODE_CASE_REL}/${DYNCODE_LIB}" "$EXPECTED_DYNCODE_SHA256" "$DYNCODE_SHA1" \
    | tee "$EVIDENCE/dyncode-provenance.txt"

# ------------------------------------------------------------------- the run
echo '===== STARTING UNCHANGED OPENFOAM PIPELINE ====='
printf 'launcher=mpirun -np %s simpleFoam -parallel\n' "$EXPECTED_RANKS"
# Final assertion immediately before launch: the library must be in place.
test -f "${DYNCODE_CASE_REL}/${DYNCODE_LIB}"
test "$(sha256sum "${DYNCODE_CASE_REL}/${DYNCODE_LIB}" | awk '{print $1}')" = "$EXPECTED_DYNCODE_SHA256"
bash ./Allrun.gadi

# ------------------------------------------------------- completion hard gates
echo '===== COMPLETION GATES ====='
solver_log=$(ls -1t logFiles/50_simpleFoam.*.log | head -n 1)
printf 'solver_log=%s\n' "$solver_log"
test -s "$solver_log"
# The precompiled library must have been LOADED, never rebuilt. Any of these
# means the artifact was not used and the timing is not the intended one.
if grep -aFq 'Creating new library' "$solver_log"; then
    echo 'ERROR: dynamicCode was rebuilt at runtime despite the precompiled artifact' >&2; exit 9
fi
if grep -aFq 'Invoking wmake libso' "$solver_log"; then
    echo 'ERROR: wmake was invoked at runtime' >&2; exit 9
fi
if grep -aFq 'Could not load' "$solver_log"; then
    echo 'ERROR: OpenFOAM could not load the precompiled dynamicCode library' >&2; exit 9
fi
grep -aFq 'Using dynamicCode for functionObject wallClockTimeStatistics' "$solver_log"
echo 'dynamicCode: precompiled library loaded, no JIT compilation'

grep -aEq "^Time = ${EXPECTED_ENDTIME}[[:space:]]*\$" "$solver_log"
grep -aFq 'Finalising parallel run' "$solver_log"
grep -aEq '^End$' "$solver_log"

grep -a 'Average wall-clock time per time step' "$solver_log" | tail -n 1 | tee "$EVIDENCE/avg-step-time.txt" || true
grep -aE 'ExecutionTime|ClockTime' "$solver_log" | tail -n 1 | tee "$EVIDENCE/clocktime.txt"
tail -n 30 "$solver_log"

printf 'run_tag=%s\npbs_jobid=%s\nnodes=%s\nranks=%s\nranks_per_node=%s\ndecomposition=hierarchical (16 6 2)\ncompiler=ICC 2021.10.0\nmpi=OpenMPI 4.1.7 (/apps/openmpi/4.1.7)\narchive_sha256=%s\nbinary_sha256=%s\ncandidate_simpleFoam=%s\nendtime=%s\nofficial_result=false\n' \
    "$RUN_TAG" "$PBS_JOBID" "$EXPECTED_NODES" "$EXPECTED_RANKS" "$EXPECTED_RANKS_PER_NODE" \
    "$EXPECTED_ARCHIVE_SHA256" "$EXPECTED_BINARY_SHA256" "$CANDIDATE_SIMPLEFOAM" "$EXPECTED_ENDTIME" \
    > "$EVIDENCE/provenance.txt"
echo C1_65M_SCREEN_PASS
