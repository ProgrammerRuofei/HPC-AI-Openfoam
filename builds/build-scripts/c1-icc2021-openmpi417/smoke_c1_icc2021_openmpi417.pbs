#!/bin/bash
# C1 runtime/provenance smoke only. This is not a performance benchmark.
#PBS -P pm78
#PBS -q normal
#PBS -N of2512_c1_smoke_v2
#PBS -l ncpus=5
#PBS -l mem=10GB
#PBS -l jobfs=5GB
#PBS -l walltime=00:10:00
#PBS -l storage=scratch/pm78
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/c1-icc2021-openmpi417/smoke/submit-logs/of2512_c1_smoke_v2.pbs.out
set -euo pipefail

ARCHIVE=/scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/c1-icc2021-openmpi417/runtime-archive/c1-icc2021-openmpi417.178166771.gadi-pbs.runtime-v2.tar.gz
EXPECTED_ARCHIVE_SHA256=16f5836b3084a284eb67e5e560d5ca245c29be14febec036b2e7f0cf7f4dc7eb
EXPECTED_BINARY_SHA256=73a3260e2dfec970a9b76de990983fffd4ed8a47363aa497a89560f5c684533d
SOURCE_CASE=/apps/OpenFOAM/2512/tutorials/incompressible/simpleFoam/pitzDaily_fused
SMOKE_ROOT=/scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/c1-icc2021-openmpi417/smoke
EVIDENCE="${SMOKE_ROOT}/evidence/c1-runtime-smoke.${PBS_JOBID:?}"
RUNTIME_CONTAINER="${PBS_JOBFS:?}/c1-runtime-smoke"
RUNTIME_ROOT="${RUNTIME_CONTAINER}/OpenFOAM-v2512"
THIRDPARTY_ROOT="${RUNTIME_CONTAINER}/ThirdParty-v2512"
CANDIDATE_SIMPLEFOAM="${RUNTIME_ROOT}/platforms/linux64IccDPInt32Opt/bin/simpleFoam"
SMOKE_CASE="${PBS_JOBFS}/pitzDaily_fused-c1-smoke"

mkdir -p "$EVIDENCE"
exec > >(tee -a "$EVIDENCE/run.log") 2>&1

preserve_smoke_logs()
{
    status=$?
    set +e
    for log in log.blockMesh log.decomposePar log.rank-launch log.simpleFoam; do
        test -f "${SMOKE_CASE}/${log}" && cp -p "${SMOKE_CASE}/${log}" "$EVIDENCE/"
    done
    printf 'pbs_exit_status=%s\n' "$status" > "$EVIDENCE/exit-status.txt"
    exit "$status"
}
trap preserve_smoke_logs EXIT

printf 'smoke_kind=runtime-correctness-only\npbs_jobid=%s\nrequested_ranks=5\n' "$PBS_JOBID"
sort -u "$PBS_NODEFILE" | tee "$EVIDENCE/nodes.txt"
test "$(sort -u "$PBS_NODEFILE" | wc -l)" -eq 1
test -r "$ARCHIVE"
printf '%s  %s\n' "$EXPECTED_ARCHIVE_SHA256" "$ARCHIVE" | sha256sum -c -

test ! -e "$RUNTIME_CONTAINER"
mkdir -p "$RUNTIME_CONTAINER"
tar -C "$RUNTIME_CONTAINER" -xzf "$ARCHIVE"
test -d "$RUNTIME_ROOT"
test -d "$THIRDPARTY_ROOT"

# The site source lacks this release metadata file. Recreate the same reviewed
# job-local metadata used for the successful build; the archive remains intact.
mkdir -p "$RUNTIME_ROOT/META-INFO"
printf 'api=2512\npatch=0\n' > "$RUNTIME_ROOT/META-INFO/api-info"
printf '%s  %s\n' d03cf08cf48ab523323a8849439b2f1073df920e29e969f51f188568a4fa0a8a "$RUNTIME_ROOT/META-INFO/api-info" | sha256sum -c -

test -x "$CANDIDATE_SIMPLEFOAM"
printf '%s  %s\n' "$EXPECTED_BINARY_SHA256" "$CANDIDATE_SIMPLEFOAM" | sha256sum -c -

module purge
module load intel-compiler/2021.10.0 openmpi/4.1.7
module list 2>&1 | tee "$EVIDENCE/modules.txt"
command -v mpirun | tee "$EVIDENCE/mpirun.path"
mpirun --version | tee "$EVIDENCE/mpirun.version"
command -v mpicc | tee "$EVIDENCE/mpicc.path"
mpicc --showme:command | tee "$EVIDENCE/mpicc.command"
test "$(command -v mpirun)" = /apps/openmpi/4.1.7/bin/mpirun
test "$(command -v mpicc)" = /apps/openmpi/4.1.7/bin/mpicc

set +u
. "$RUNTIME_ROOT/etc/bashrc" WM_COMPILER=Icc WM_MPLIB=SYSTEMOPENMPI WM_COMPILE_OPTION=Opt
set -u
test "$WM_PROJECT_VERSION" = v2512
test "$WM_MPLIB" = SYSTEMOPENMPI
test "$WM_OPTIONS" = linux64IccDPInt32Opt
test "$WM_THIRD_PARTY_DIR" = "$THIRDPARTY_ROOT"
test "$(command -v simpleFoam)" = "$CANDIDATE_SIMPLEFOAM"
test "$(realpath "$(command -v simpleFoam)")" = "$(realpath "$CANDIDATE_SIMPLEFOAM")"
case "$(command -v simpleFoam)" in /apps/OpenFOAM/2512/*) echo 'ERROR: site simpleFoam fallback' >&2; exit 6;; esac

file "$CANDIDATE_SIMPLEFOAM" | tee "$EVIDENCE/simpleFoam.file"
ldd "$CANDIDATE_SIMPLEFOAM" | tee "$EVIDENCE/simpleFoam.ldd"
! grep -q 'not found' "$EVIDENCE/simpleFoam.ldd"
grep -Fq "libOpenFOAM.so => ${RUNTIME_ROOT}/platforms/linux64IccDPInt32Opt/lib/" "$EVIDENCE/simpleFoam.ldd"
grep -Fq "libPstream.so => ${RUNTIME_ROOT}/platforms/linux64IccDPInt32Opt/lib/sys-openmpi/" "$EVIDENCE/simpleFoam.ldd"
grep -Fq 'libmpi.so.40 => /apps/openmpi/4.1.7/' "$EVIDENCE/simpleFoam.ldd"
! grep -Fq '/apps/OpenFOAM/2512/' "$EVIDENCE/simpleFoam.ldd"

test -d "$SOURCE_CASE"
cp -a "$SOURCE_CASE" "$SMOKE_CASE"
cd "$SMOKE_CASE"
grep -Eq '^[[:space:]]*numberOfSubdomains[[:space:]]+5;' system/decomposeParDict
grep -Eq '^[[:space:]]*n[[:space:]]+\(5 1 1\);' system/decomposeParDict
blockMesh > log.blockMesh 2>&1
decomposePar -force > log.decomposePar 2>&1
mpirun -np 5 bash -c 'printf "rank=%s size=%s node=%s\n" "$OMPI_COMM_WORLD_RANK" "$OMPI_COMM_WORLD_SIZE" "$(hostname)"' | sort > log.rank-launch
test "$(grep -c '^rank=' log.rank-launch)" -eq 5
test "$(awk -F'[ =]' '/^rank=/{print $4}' log.rank-launch | sort -u)" = 5
mpirun -np 5 "$CANDIDATE_SIMPLEFOAM" -parallel > log.simpleFoam 2>&1
grep -Fq 'Finalising parallel run' log.simpleFoam
grep -Eq '^End$' log.simpleFoam

printf 'archive_sha256=%s\nbinary_sha256=%s\ncandidate_simpleFoam=%s\nopenmpi=/apps/openmpi/4.1.7\nranks=5\n' \
    "$EXPECTED_ARCHIVE_SHA256" "$EXPECTED_BINARY_SHA256" "$CANDIDATE_SIMPLEFOAM" > "$EVIDENCE/provenance.txt"
echo C1_RUNTIME_SMOKE_PASS
