#!/bin/bash
# Test the unpreloaded, HCOLL-eligible 2025-style runtime policy on two SPR nodes.
#PBS -P pm78
#PBS -q normalsr
#PBS -N icx26_ompi_policy25_2n
#PBS -l ncpus=208
#PBS -l mem=32GB
#PBS -l jobfs=8GB
#PBS -l walltime=00:10:00
#PBS -l storage=scratch/pm78
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/gadi-icx20262-ompi5010/submit-logs/preflight_policy2025_2n_v1.pbs.out
set -euo pipefail
STACK_ROOT=/scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/gadi-gcc162-ompi5010
GCC_ARCHIVE="$STACK_ROOT/runtime-archive/gcc-16.2.0.181342083.gadi-pbs.tar.gz"
MPI_ARCHIVE="$STACK_ROOT/runtime-archive/openmpi-5.0.10.181346004.gadi-pbs.tar.gz"
GCC_SHA=1149c0d97412ae3741cc18d60f233cdd3dd5e33bc92c55c59db2dd8cf535b714
MPI_SHA=8ac121e4f64eb329dc33cd2cc8229dc9f655064a757cbcaa36af962b21619fc6
UCX_SHA=f983f10603d6b9e623f1d3a0ef0f2a69c54a41e7a72c0c41e8694cfabaf588a7
JOB_ID=${PBS_JOBID:?}
JOBFS_ROOT="${PBS_JOBFS:?}/icx26-ompi-policy2025-2n-$JOB_ID"
EVIDENCE="/scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/gadi-icx20262-ompi5010-of2512/evidence/policy2025-2n.$JOB_ID"
GCC_PREFIX="$JOBFS_ROOT/gcc-16.2.0"
MPI_PREFIX="$JOBFS_ROOT/openmpi-5.0.10"
STAGER="$PBS_O_WORKDIR/builds/build-scripts/gadi-gcc162-ompi5010/stage_ompi5010_node_v2.sh"
test "${PBS_NCPUS:?}" -eq 208
test ! -e "$EVIDENCE"
test -f "$STAGER"
mkdir -p "$EVIDENCE"
exec > >(tee "$EVIDENCE/run.log") 2>&1
preserve() {
    rc=$?; set +e
    printf 'script_exit_rc=%s\n' "$rc" > "$EVIDENCE/exit-status.txt"
    exit "$rc"
}
trap preserve EXIT
printf 'pbs_jobid=%s\nscored=false\nreason=two_node_unpreloaded_hcoll_eligible_runtime_preflight\n' "$PBS_JOBID" > "$EVIDENCE/provenance.txt"
sort -u "$PBS_NODEFILE" | tee "$EVIDENCE/nodes.txt"
test "$(sort -u "$PBS_NODEFILE" | wc -l)" -eq 2
test "$(awk '{n[$0]++} END {for (h in n) print n[h]}' "$PBS_NODEFILE" | sort -u)" = 104
module purge
module load ucx/1.18.1 ucc/1.4.4
module list 2>&1
test "${UCX_ROOT:?}" = /apps/ucx/1.18.1
test "${UCC_ROOT:?}" = /apps/ucc/1.4.4
printf '%s  %s\n' "$UCX_SHA" "$UCX_ROOT/lib/libucp.so.0" | sha256sum -c -
test "$(sed -n "1p;105p" "$PBS_NODEFILE" | sort -u | wc -l)" -eq 2
for idx in 0 104; do
    /opt/pbs/default/bin/pbsdsh -n "$idx" -s -- /bin/bash "$STAGER" "$JOBFS_ROOT" "$GCC_ARCHIVE" "$MPI_ARCHIVE" "$GCC_SHA" "$MPI_SHA" "$EVIDENCE/stage-node-$idx.log"
    test -s "$EVIDENCE/stage-node-$idx.log"
    grep -q 'STAGE_OMPI5010_NODE_PASS' "$EVIDENCE/stage-node-$idx.log"
    expected_host=$(sed -n "$((idx + 1))p" "$PBS_NODEFILE")
    grep -Fq "host=$expected_host " "$EVIDENCE/stage-node-$idx.log"
done
test "$(grep -h STAGE_OMPI5010_NODE_PASS "$EVIDENCE"/stage-node-*.log | sed -E 's/.*host=([^ ]+).*/\1/' | sort -u | wc -l)" -eq 2
export OPAL_PREFIX="$MPI_PREFIX" PMIX_PREFIX="$MPI_PREFIX" PRTE_PREFIX="$MPI_PREFIX"
export OMPI_CC="$GCC_PREFIX/bin/gcc" OMPI_CXX="$GCC_PREFIX/bin/g++"
export PATH="$MPI_PREFIX/bin:$GCC_PREFIX/bin:$PATH"
export LD_LIBRARY_PATH="$MPI_PREFIX/lib:$GCC_PREFIX/lib64:/opt/pbs/default/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
unset LD_PRELOAD
printf 'unpreloaded\n' > "$EVIDENCE/runtime-policy.txt"
gcc --version | head -n 1 | grep -Fx 'gcc (GCC) 16.2.0'
mpirun --version | head -n 1 | grep -Fx 'mpirun (Open MPI) 5.0.10'
mpicc --showme:command | grep -Fx "$GCC_PREFIX/bin/gcc"
prte_info | tee "$EVIDENCE/prte-info.txt"
grep -Eq 'MCA ras: pbs' "$EVIDENCE/prte-info.txt"
grep -Eq 'MCA plm: tm' "$EVIDENCE/prte-info.txt"
cat > "$EVIDENCE/mpi-smoke.c" <<'C_EOF'
#define _GNU_SOURCE
#include <mpi.h>
#include <dlfcn.h>
#include <link.h>
#include <stdio.h>
#include <string.h>
#include <unistd.h>
static char ucp_path[4096];
static int locate(struct dl_phdr_info *info, size_t size, void *data) {
    (void)size; (void)data;
    if (info->dlpi_name && strstr(info->dlpi_name, "libucp.so")) {
        snprintf(ucp_path, sizeof(ucp_path), "%s", info->dlpi_name);
        return 1;
    }
    return 0;
}
int main(int argc, char **argv) {
    int rank, size, sum;
    char host[256];
    MPI_Init(&argc, &argv);
    MPI_Comm_rank(MPI_COMM_WORLD, &rank);
    MPI_Comm_size(MPI_COMM_WORLD, &size);
    MPI_Allreduce(&rank, &sum, 1, MPI_INT, MPI_SUM, MPI_COMM_WORLD);
    gethostname(host, sizeof host);
    host[sizeof host - 1] = 0;
    dl_iterate_phdr(locate, NULL);
    void *handle = ucp_path[0] ? dlopen(ucp_path, RTLD_NOW | RTLD_NOLOAD) : NULL;
    const char *(*version)(void) = handle ? dlsym(handle, "ucp_get_version_string") : NULL;
    printf("POLICY2025_CROSS_NODE rank=%d size=%d host=%s path=%s version=%s sum=%d\n",
           rank, size, host, ucp_path[0] ? ucp_path : "MISSING",
           version ? version() : "MISSING", sum);
    fflush(stdout);
    if (handle) dlclose(handle);
    MPI_Finalize();
    return size == 2 && sum == 1 && ucp_path[0] && version ? 0 : 1;
}
C_EOF
mpicc "$EVIDENCE/mpi-smoke.c" -ldl -o "$EVIDENCE/mpi-smoke"
ldd "$EVIDENCE/mpi-smoke" | tee "$EVIDENCE/mpi-smoke.ldd"
! grep -Fq 'not found' "$EVIDENCE/mpi-smoke.ldd"
grep -F "$MPI_PREFIX/lib/libmpi.so" "$EVIDENCE/mpi-smoke.ldd"
grep -F "libucp.so.0" "$EVIDENCE/mpi-smoke.ldd"
timeout -k 5s 60s mpirun --prefix "$MPI_PREFIX" --map-by ppr:1:node --mca pml ucx --mca coll_base_verbose 30 --report-bindings -np 2 "$EVIDENCE/mpi-smoke" \
    2>&1 | tee "$EVIDENCE/mpi-smoke.txt"
grep -Eq '^POLICY2025_CROSS_NODE rank=0 size=2 host=.+ path=.+ version=.+ sum=1$' "$EVIDENCE/mpi-smoke.txt"
grep -Eq '^POLICY2025_CROSS_NODE rank=1 size=2 host=.+ path=.+ version=.+ sum=1$' "$EVIDENCE/mpi-smoke.txt"
test "$(sed -nE 's/^POLICY2025_CROSS_NODE rank=[01] size=2 host=([^ ]+) path=.*/\1/p' "$EVIDENCE/mpi-smoke.txt" | sort -u | wc -l)" -eq 2
! grep -Fq "UCP API version is incompatible" "$EVIDENCE/mpi-smoke.txt"
! grep -Eq "POLICY2025_CROSS_NODE.*(path=MISSING|version=MISSING)" "$EVIDENCE/mpi-smoke.txt"
# Keep verbose collective selection as evidence; a two-rank choice is not a 416-rank result.
echo ICX20262_OMPI5010_POLICY2025_2N_PASS
