#!/bin/bash
# Check private ICX 2026.2 with the retained GCC 16.2 / Open MPI 5.0.10
# runtime on one Gadi SPR node before building OpenFOAM. All extraction is
# confined to this job's JOBFS; logs have job-keyed names on scratch.
#PBS -P pm78
#PBS -q normalsr
#PBS -N icx26_ompi5_probe
#PBS -l ncpus=4
#PBS -l mem=16GB
#PBS -l jobfs=30GB
#PBS -l walltime=00:20:00
#PBS -l storage=scratch/pm78
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/gadi-icx20262-ompi5010/submit-logs/smoke_icx_ompi_1n_v1.pbs.out
set -euo pipefail

BASE=/scratch/pm78/kj7183/openfoam_cpu/toolchain-screening
INTEL_ARCHIVE="$BASE/gadi-icx20262-impi202119/runtime-archive/gadi-icx20262-impi202119.182138851.gadi-pbs.tar.gz"
INTEL_SHA=013ea4758e05b3656b5474845577fcd0631b28d783e115b5e42d644d321a2fbc
GCC_ARCHIVE="$BASE/gadi-gcc162-ompi5010/runtime-archive/gcc-16.2.0.181342083.gadi-pbs.tar.gz"
MPI_ARCHIVE="$BASE/gadi-gcc162-ompi5010/runtime-archive/openmpi-5.0.10.181346004.gadi-pbs.tar.gz"
GCC_SHA=1149c0d97412ae3741cc18d60f233cdd3dd5e33bc92c55c59db2dd8cf535b714
MPI_SHA=8ac121e4f64eb329dc33cd2cc8229dc9f655064a757cbcaa36af962b21619fc6
JOB_ID=${PBS_JOBID:?}
ROOT="${PBS_JOBFS:?}/icx20262-ompi5010-$JOB_ID"
EVIDENCE="$BASE/gadi-icx20262-ompi5010/evidence/smoke.$JOB_ID"
COMPILER_PREFIX="$ROOT/opt/intel/oneapi/compiler/2026.2"
GCC_PREFIX="$ROOT/gcc-16.2.0"
MPI_PREFIX="$ROOT/openmpi-5.0.10"

test "${PBS_NCPUS:?}" -eq 4
test ! -e "$ROOT"; test ! -e "$EVIDENCE"
for item in "$INTEL_SHA $INTEL_ARCHIVE" "$GCC_SHA $GCC_ARCHIVE" "$MPI_SHA $MPI_ARCHIVE"; do
    read -r hash archive <<< "$item"
    printf '%s  %s\n' "$hash" "$archive" | sha256sum -c -
done
mkdir -p "$ROOT/opt/intel" "$EVIDENCE"
exec > >(tee "$EVIDENCE/probe.log") 2>&1
printf 'job_id=%s\njobfs=%s\n' "$JOB_ID" "$PBS_JOBFS"
grep -m1 'model name' /proc/cpuinfo

module purge
module load ucx/1.18.1 ucc/1.4.4
module list 2>&1
test "${UCX_ROOT:?}" = /apps/ucx/1.18.1
test "${UCC_ROOT:?}" = /apps/ucc/1.4.4
tar -xzf "$INTEL_ARCHIVE" -C "$ROOT/opt/intel"
tar -xzf "$GCC_ARCHIVE" -C "$ROOT"
tar -xzf "$MPI_ARCHIVE" -C "$ROOT"
test -f "$COMPILER_PREFIX/env/vars.sh"
test -x "$GCC_PREFIX/bin/gcc"
test -x "$MPI_PREFIX/bin/mpicxx"
set +u
. "$COMPILER_PREFIX/env/vars.sh"
set -u
export OPAL_PREFIX="$MPI_PREFIX" PMIX_PREFIX="$MPI_PREFIX" PRTE_PREFIX="$MPI_PREFIX"
export OMPI_CC=icx OMPI_CXX=icpx
export PATH="$MPI_PREFIX/bin:$PATH"
export LD_LIBRARY_PATH="$MPI_PREFIX/lib:$GCC_PREFIX/lib64:/opt/pbs/default/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
test "$(command -v icx)" = "$COMPILER_PREFIX/bin/icx"
test "$(command -v mpirun)" = "$MPI_PREFIX/bin/mpirun"
icx --version | tee "$EVIDENCE/icx-version.txt"
icpx --version | tee "$EVIDENCE/icpx-version.txt"
grep -F '2026.2.0' "$EVIDENCE/icx-version.txt"
grep -F '2026.2.0' "$EVIDENCE/icpx-version.txt"
mpirun --version | head -n 1 | grep -Fx 'mpirun (Open MPI) 5.0.10'
mpicc --showme:command | tee "$EVIDENCE/mpicc-wrapper.txt" | grep -Fx icx
mpicxx --showme:command | tee "$EVIDENCE/mpicxx-wrapper.txt" | grep -Fx icpx

cat > "$EVIDENCE/mpi-smoke.cpp" <<'CPP_EOF'
#include <mpi.h>
#include <cstdio>
#include <cstring>
int main(int argc, char **argv) {
    MPI_Init(&argc, &argv);
    int rank = -1, size = -1, len = 0;
    char version[MPI_MAX_LIBRARY_VERSION_STRING] = {};
    MPI_Comm_rank(MPI_COMM_WORLD, &rank);
    MPI_Comm_size(MPI_COMM_WORLD, &size);
    MPI_Get_library_version(version, &len);
    std::printf("ICX20262_OMPI5010_RANK=%d SIZE=%d LIB=%.*s\n", rank, size, len, version);
    MPI_Finalize();
    return size == 2 && std::strstr(version, "Open MPI") ? 0 : 1;
}
CPP_EOF
mpicxx -O2 "$EVIDENCE/mpi-smoke.cpp" -o "$ROOT/mpi-smoke"
ldd "$ROOT/mpi-smoke" | tee "$EVIDENCE/mpi-smoke.ldd"
! grep -Fq 'not found' "$EVIDENCE/mpi-smoke.ldd"
grep -F "$MPI_PREFIX/lib/libmpi.so" "$EVIDENCE/mpi-smoke.ldd"
mpirun --mca pml ucx -np 2 "$ROOT/mpi-smoke" | tee "$EVIDENCE/mpi-smoke.txt"
grep -q '^ICX20262_OMPI5010_RANK=0 SIZE=2 ' "$EVIDENCE/mpi-smoke.txt"
grep -q '^ICX20262_OMPI5010_RANK=1 SIZE=2 ' "$EVIDENCE/mpi-smoke.txt"
test "$(grep -c '^ICX20262_OMPI5010_RANK=' "$EVIDENCE/mpi-smoke.txt")" -eq 2
echo ICX20262_OMPI5010_ABI_SMOKE_PASS
