#!/bin/bash
# C1-AVX512 runtime smoke + OptAVX512 dynamicCode artifact, in ONE cheap job.
#
# THIS IS NOT A PERFORMANCE TEST. It verifies only that the architecture-
# targeted build is executable and internally consistent on Cascade Lake.
#
# Why the dynamicCode artifact must be rebuilt rather than reused: the coded
# functionObject's SHA1 hashes the SOURCE TEXT, so it is identical for every
# compiler and option (6e8d888a...). But OpenFOAM loads it from
#     dynamicCode/platforms/$WM_OPTIONS/lib/
# and WM_OPTIONS is linux64IccDPInt32OptAVX512 here versus
# linux64IccDPInt32Opt for C1 generic. The generic .so sits at a path this
# runtime never searches, and is linked against the generic platform libs.
# It is therefore neither found nor valid here. The validated generic artifact
# is left untouched; this one is published and hashed separately.
#
# The AVX512 build archive ships only etc/ + platforms/, exactly like the
# original C1 archive did before the runtime-v2 repair. bin/ and META-INFO are
# restored in JOBFS from the same authoritative v2512 tree; the archive on
# /scratch is never modified.
#PBS -P pm78
#PBS -q normal
#PBS -N of2512_c1avx512_smoke
#PBS -l ncpus=8
#PBS -l mem=32GB
#PBS -l jobfs=20GB
#PBS -l walltime=00:30:00
#PBS -l storage=scratch/pm78
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/c1avx512-icc2021-openmpi417/smoke/submit-logs/of2512_c1avx512_smoke.pbs.out
set -euo pipefail

ARCHIVE=/scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/c1avx512-icc2021-openmpi417/runtime-archive/c1avx512-icc2021-openmpi417.178640018.gadi-pbs.tar.gz
EXPECTED_ARCHIVE_SHA256=9333da40c73a12320919815bc5e44e2ba037199d2d75c509c55090d3d5e815c5
EXPECTED_BINARY_SHA256=b0525c1551346f1379fb673f35a736d019791bb2355d0b75ec701b93bf05a7a3
PLATFORM=linux64IccDPInt32OptAVX512
BINARY_REL="platforms/${PLATFORM}/bin/simpleFoam"

AUTHORITATIVE_SOURCE=/apps/OpenFOAM/2512
WORKLOAD_CASE=/scratch/pm78/kj7183/openfoam_cpu/case/occDrivAerStaticMesh
FO_FILE="${WORKLOAD_CASE}/system/FOwallClockTimeStatistics"
EXPECTED_FO_SHA256=0a0e5d072527bc1e67e5bc505da30bec0abebc67262aa47ecaece4d13b2ece08
DYNCODE_SHA1=6e8d888ad28997c1bc9eebd1c08a1a15774516a4
LIB_BASENAME="libwallClockTimeStatistics_${DYNCODE_SHA1}.so"

SMOKE_ROOT=/scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/c1avx512-icc2021-openmpi417/smoke
ARTIFACT_ROOT=/scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/c1avx512-icc2021-openmpi417/dynamiccode-artifact
ARTIFACT="${ARTIFACT_ROOT}/${LIB_BASENAME}"
EVIDENCE="${SMOKE_ROOT}/evidence/c1avx512-smoke.${PBS_JOBID:?}"

CONTAINER="${PBS_JOBFS:?}/c1avx512-runtime"
RUNTIME_ROOT="${CONTAINER}/OpenFOAM-v2512"
THIRDPARTY_ROOT="${CONTAINER}/ThirdParty-v2512"
CASE="${PBS_JOBFS}/pitzDaily_fused-avx512-smoke"
NRANKS=5

mkdir -p "$EVIDENCE" "$ARTIFACT_ROOT"
exec > >(tee -a "$EVIDENCE/run.log") 2>&1
trap 'status=$?; set +e; for l in log.blockMesh log.decomposePar log.rank-launch log.simpleFoam log.simpleFoam-serial; do test -f "${CASE}/${l}" && cp -p "${CASE}/${l}" "$EVIDENCE/"; done; printf "pbs_exit_status=%s\n" "$status" > "$EVIDENCE/exit-status.txt"; exit "$status"' EXIT

printf 'smoke_kind=avx512-runtime-correctness-only\nofficial_result=false\nclassification=SMOKE / NON-PERFORMANCE-RESULT\npbs_jobid=%s\nplatform=%s\n' "$PBS_JOBID" "$PLATFORM"

echo '===== COMPUTE-NODE ISA SUPPORT ====='
grep -m1 'model name' /proc/cpuinfo | tee "$EVIDENCE/node-cpu.txt"
grep -m1 ^flags /proc/cpuinfo | tr ' ' '\n' | grep -i '^avx512' | sort | tee "$EVIDENCE/node-avx512-flags.txt"
for isa in avx512f avx512cd avx512bw avx512dq avx512vl; do
    grep -qx "$isa" "$EVIDENCE/node-avx512-flags.txt" || { echo "ERROR: node lacks $isa" >&2; exit 8; }
done
echo 'node ISA OK: CORE-AVX512 target set present'

echo '===== INPUT PROVENANCE ====='
printf '%s  %s\n' "$EXPECTED_ARCHIVE_SHA256" "$ARCHIVE" | sha256sum -c -
printf '%s  %s\n' "$EXPECTED_FO_SHA256" "$FO_FILE" | sha256sum -c -
test ! -e "$ARTIFACT"

echo '===== TOOLCHAIN ====='
module purge
module load intel-compiler/2021.10.0 openmpi/4.1.7
module list 2>&1 | tee "$EVIDENCE/modules.txt"
icc --version > "$EVIDENCE/icc.version" 2>&1; head -1 "$EVIDENCE/icc.version"
grep -Fq '2021.10.0' "$EVIDENCE/icc.version"
mpirun --version > "$EVIDENCE/mpirun.version" 2>&1; head -1 "$EVIDENCE/mpirun.version"
grep -Fq 'Open MPI) 4.1.7' "$EVIDENCE/mpirun.version"
test "$(command -v mpirun)" = /apps/openmpi/4.1.7/bin/mpirun
test "$(command -v mpicc)" = /apps/openmpi/4.1.7/bin/mpicc
env | grep '^I_MPI_' | sort | tee "$EVIDENCE/i_mpi_vars.txt" || true

echo '===== STAGE AVX512 RUNTIME ====='
test ! -e "$CONTAINER"; mkdir -p "$CONTAINER"
tar -C "$CONTAINER" -xzf "$ARCHIVE"
test -d "$RUNTIME_ROOT"; test -d "$THIRDPARTY_ROOT"
test "$(sha256sum "$RUNTIME_ROOT/$BINARY_REL" | awk '{print $1}')" = "$EXPECTED_BINARY_SHA256"
# Restore the two pieces the build archive omits (same reviewed content as the
# generic runtime-v2 repair); JOBFS only, /scratch archive untouched.
test ! -e "$RUNTIME_ROOT/bin"
rsync -a "$AUTHORITATIVE_SOURCE/bin/" "$RUNTIME_ROOT/bin/"
test -x "$RUNTIME_ROOT/bin/foamEtcFile"
mkdir -p "$RUNTIME_ROOT/META-INFO"
printf 'api=2512\npatch=0\n' > "$RUNTIME_ROOT/META-INFO/api-info"
printf '%s  %s\n' d03cf08cf48ab523323a8849439b2f1073df920e29e969f51f188568a4fa0a8a "$RUNTIME_ROOT/META-INFO/api-info" | sha256sum -c -

echo '===== BUILD-TIME SOURCE INPUT (headers/wmake only) ====='
cp -a "$AUTHORITATIVE_SOURCE/wmake" "$RUNTIME_ROOT/wmake"
ln -s "$AUTHORITATIVE_SOURCE/src" "$RUNTIME_ROOT/src"
test -d "$RUNTIME_ROOT/wmake/rules/linux64Icc"
# Same reviewed ICC 2021.10 aligned-allocation workaround as the build used.
# linux64Icc/c++ is included for EVERY WM_COMPILE_OPTION, so it covers OptAVX512.
ICC_RULE="${RUNTIME_ROOT}/wmake/rules/linux64Icc/c++"
printf '\n# C1 ICC 2021.10 aligned-allocation compatibility workaround\nc++FLAGS += -D__cpp_aligned_new=201606L\n' >> "$ICC_RULE"
grep -Fq -- '-D__cpp_aligned_new=201606L' "$ICC_RULE"

echo '===== OPENFOAM ENVIRONMENT (OptAVX512) ====='
set +u
. "$RUNTIME_ROOT/etc/bashrc" WM_COMPILER=Icc WM_MPLIB=SYSTEMOPENMPI WM_COMPILE_OPTION=OptAVX512
set -u
printf 'WM_PROJECT_VERSION=%s\nWM_OPTIONS=%s\nWM_COMPILE_OPTION=%s\nWM_MPLIB=%s\nFOAM_MPI=%s\n' \
    "$WM_PROJECT_VERSION" "$WM_OPTIONS" "$WM_COMPILE_OPTION" "$WM_MPLIB" "$FOAM_MPI" | tee "$EVIDENCE/foam-env.txt"
test "$WM_PROJECT_VERSION" = v2512
test "$WM_OPTIONS" = "$PLATFORM"
test "$WM_COMPILE_OPTION" = OptAVX512
test "$WM_MPLIB" = SYSTEMOPENMPI
test "$(command -v simpleFoam)" = "${RUNTIME_ROOT}/${BINARY_REL}"
case "$(command -v simpleFoam)" in /apps/OpenFOAM/2512/*) echo 'ERROR: site simpleFoam fallback' >&2; exit 6;; esac

echo '===== LINKAGE ISOLATION (simpleFoam) ====='
ldd "${RUNTIME_ROOT}/${BINARY_REL}" | tee "$EVIDENCE/simpleFoam.ldd"
! grep -q 'not found' "$EVIDENCE/simpleFoam.ldd"
grep -Fq "libOpenFOAM.so => ${RUNTIME_ROOT}/platforms/${PLATFORM}/lib/" "$EVIDENCE/simpleFoam.ldd"
grep -Fq "libPstream.so => ${RUNTIME_ROOT}/platforms/${PLATFORM}/lib/sys-openmpi/" "$EVIDENCE/simpleFoam.ldd"
grep -Fq 'libmpi.so.40 => /apps/openmpi/4.1.7/' "$EVIDENCE/simpleFoam.ldd"
! grep -Fq '/apps/OpenFOAM/2512/platforms/' "$EVIDENCE/simpleFoam.ldd"
! grep -Fq 'linux64Gcc' "$EVIDENCE/simpleFoam.ldd"
! grep -Eqi 'intel-mpi|/impi|libmpi\.so\.12|libmpicxx' "$EVIDENCE/simpleFoam.ldd"

echo '===== BUILD wmake TOOLS (lesson L5) ====='
"$RUNTIME_ROOT/wmake/src/Allmake" > "$EVIDENCE/wmake-tools.log" 2>&1
test -x "$RUNTIME_ROOT/platforms/tools/linux64Icc/wmkdepend"

echo '===== SMOKE CASE (tutorial, NOT the benchmark workload) ====='
cp -a "$AUTHORITATIVE_SOURCE/tutorials/incompressible/simpleFoam/pitzDaily_fused" "$CASE"
cd "$CASE"
cp -p "$FO_FILE" system/FOwallClockTimeStatistics
printf '\nfunctions\n{\n    #include "FOwallClockTimeStatistics"\n}\n' >> system/controlDict
sed -i -E 's/^(endTime[[:space:]]+)[0-9]+;/\120;/' system/controlDict
grep -Eq '^endTime[[:space:]]+20;' system/controlDict
grep -Eq '^[[:space:]]*numberOfSubdomains[[:space:]]+5;' system/decomposeParDict

echo '===== SERIAL RUN: TRIGGER OptAVX512 dynamicCode COMPILATION ====='
blockMesh > log.blockMesh 2>&1
simpleFoam > log.simpleFoam-serial 2>&1
grep -Fq 'Invoking wmake libso' log.simpleFoam-serial
grep -aEq '^End$' log.simpleFoam-serial
grep -Fq 'Average wall-clock time per time step' log.simpleFoam-serial
BUILT="${CASE}/dynamicCode/platforms/${PLATFORM}/lib/${LIB_BASENAME}"
test -f "$BUILT"
printf 'dyncode_built=%s\n' "$BUILT"

echo '===== dynamicCode LINKAGE ISOLATION ====='
ldd "$BUILT" | tee "$EVIDENCE/dyncode.ldd"
! grep -q 'not found' "$EVIDENCE/dyncode.ldd"
grep -Fq "libOpenFOAM.so => ${RUNTIME_ROOT}/platforms/${PLATFORM}/lib/" "$EVIDENCE/dyncode.ldd"
grep -Fq "libfiniteVolume.so => ${RUNTIME_ROOT}/platforms/${PLATFORM}/lib/" "$EVIDENCE/dyncode.ldd"
! grep -Fq '/apps/OpenFOAM/2512/platforms/' "$EVIDENCE/dyncode.ldd"
! grep -Fq 'linux64Gcc' "$EVIDENCE/dyncode.ldd"
! grep -Eqi 'intel-mpi|/impi|libmpi\.so\.12' "$EVIDENCE/dyncode.ldd"

echo '===== PARALLEL SMOKE (5 ranks) ====='
decomposePar -force > log.decomposePar 2>&1
mpirun -np "$NRANKS" bash -c 'printf "rank=%s size=%s node=%s\n" "$OMPI_COMM_WORLD_RANK" "$OMPI_COMM_WORLD_SIZE" "$(hostname)"' | sort > log.rank-launch
test "$(grep -c '^rank=' log.rank-launch)" -eq "$NRANKS"
mpirun -np "$NRANKS" simpleFoam -parallel > log.simpleFoam 2>&1
# An illegal instruction from a mis-targeted build surfaces as a signal, not End.
! grep -Eqi 'illegal instruction|SIGILL' log.simpleFoam
grep -Fq 'Finalising parallel run' log.simpleFoam
grep -aEq '^End$' log.simpleFoam
grep -Fq 'Average wall-clock time per time step' log.simpleFoam
# The parallel run must LOAD the library, never recompile it.
! grep -Fq 'Invoking wmake libso' log.simpleFoam

echo '===== PUBLISH dynamicCode ARTIFACT (separate from the generic one) ====='
cp -p "$BUILT" "$ARTIFACT"
chmod 0644 "$ARTIFACT"
sha256sum "$ARTIFACT" | tee "${ARTIFACT}.sha256"
cp -p "$EVIDENCE/dyncode.ldd" "${ARTIFACT_ROOT}/${LIB_BASENAME}.ldd"
{
  printf 'artifact=%s\n' "$LIB_BASENAME"
  printf 'artifact_sha256=%s\n' "$(awk '{print $1}' "${ARTIFACT}.sha256")"
  printf 'dynamiccode_sha1=%s\n' "$DYNCODE_SHA1"
  printf 'platform=%s\n' "$PLATFORM"
  printf 'wm_compile_option=OptAVX512\n'
  printf 'build_pbs_job=%s\nbuild_node=%s\n' "$PBS_JOBID" "$(hostname)"
  printf 'runtime_archive_sha256=%s\n' "$EXPECTED_ARCHIVE_SHA256"
  printf 'simpleFoam_sha256=%s\n' "$EXPECTED_BINARY_SHA256"
  printf 'note=distinct from the generic linux64IccDPInt32Opt artifact; same source SHA1, different platform path and linkage\n'
} | tee "${ARTIFACT_ROOT}/${LIB_BASENAME}.provenance"

echo C1_AVX512_SMOKE_PASS
