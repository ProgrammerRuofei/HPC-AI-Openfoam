#!/bin/bash
#PBS -P pm78
#PBS -q normalsr
#PBS -N icx26_impi19_private
#PBS -l ncpus=4
#PBS -l mem=16GB
#PBS -l jobfs=30GB
#PBS -l walltime=00:20:00
#PBS -l storage=scratch/pm78
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/gadi-icx20262-impi202119/submit-logs/smoke_private_toolchain_1n.pbs.out
set -euo pipefail

stack=gadi-icx20262-impi202119
root=/scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/$stack
cache=$root/rpm-cache
job_id=${PBS_JOBID:?}
evidence=$root/evidence/$job_id
work=${PBS_JOBFS:?}/$stack-$job_id
[[ ${PBS_NCPUS:?} -eq 4 && ! -e $evidence && ! -e $work ]]
test -s "$cache/manifest.tsv"
mkdir -p "$evidence" "$work"
exec > >(tee "$evidence/probe.log") 2>&1

module purge
while IFS=$'\t' read -r name version size sha filename; do
    [[ $name == intel-oneapi-* && $filename == intel-oneapi-*.rpm ]]
    [[ $(stat -c %s "$cache/$filename") == "$size" ]]
    printf '%s  %s\n' "$sha" "$cache/$filename" | sha256sum -c -
    ( cd "$work" && rpm2cpio "$cache/$filename" | cpio -idmu --quiet )
done < "$cache/manifest.tsv"

oneapi=$work/opt/intel/oneapi
compiler=$oneapi/compiler/2026.2
mpi=$oneapi/mpi/2021.19
test -d "$compiler"; test -d "$mpi"
test -f "$compiler/env/vars.sh"; test -f "$mpi/env/vars.sh"
set +u
. "$compiler/env/vars.sh"
. "$mpi/env/vars.sh"
set -u
export I_MPI_HYDRA_BOOTSTRAP=rsh
export I_MPI_HYDRA_BOOTSTRAP_EXEC=/opt/pbs/default/bin/pbs_tmrsh
for tool in icx icpx mpiicx mpiicpx mpirun; do command -v "$tool"; done
icx --version | tee "$evidence/icx-version.txt"
mpirun -version | tee "$evidence/mpi-version.txt"
mpiicpx -show | tee "$evidence/mpiicpx-show.txt"
grep -F '2026.2' "$evidence/icx-version.txt"
grep -F '2021.19' "$evidence/mpi-version.txt"

cat > "$work/mpi-smoke.cpp" <<'CPP'
#include <mpi.h>
#include <cstdio>
#include <cstring>
#include <unistd.h>
int main(int argc, char **argv) {
    MPI_Init(&argc, &argv);
    int rank = -1, size = -1, len = 0;
    char host[256] = {}, version[MPI_MAX_LIBRARY_VERSION_STRING] = {};
    MPI_Comm_rank(MPI_COMM_WORLD, &rank);
    MPI_Comm_size(MPI_COMM_WORLD, &size);
    MPI_Get_library_version(version, &len);
    gethostname(host, sizeof(host));
    std::printf("ICX20262_IMPI202119_RANK=%d SIZE=%d HOST=%s LIB=%.*s\n", rank, size, host, len, version);
    MPI_Finalize();
    return size == 2 && std::strstr(version, "Intel(R) MPI") && std::strstr(version, "2021.19") ? 0 : 1;
}
CPP
mpiicpx -O2 "$work/mpi-smoke.cpp" -o "$work/mpi-smoke"
ldd "$work/mpi-smoke" | tee "$evidence/mpi-smoke.ldd"
! grep -Fq 'not found' "$evidence/mpi-smoke.ldd"
grep -E "libmpi\.so.*$mpi/" "$evidence/mpi-smoke.ldd"
I_MPI_DEBUG=4 mpirun -n 2 "$work/mpi-smoke" 2>&1 | tee "$evidence/mpi-smoke.txt"
[[ $(grep -c '^ICX20262_IMPI202119_RANK=' "$evidence/mpi-smoke.txt") -eq 2 ]]
grep -q '^ICX20262_IMPI202119_RANK=0 SIZE=2 ' "$evidence/mpi-smoke.txt"
grep -q '^ICX20262_IMPI202119_RANK=1 SIZE=2 ' "$evidence/mpi-smoke.txt"

archive=$root/runtime-archive/$stack.$job_id.tar.gz
mkdir -p "${archive%/*}"
tar -C "$work/opt/intel" -czf "$archive" oneapi
sha256sum "$archive" | tee "$archive.sha256"
( cd "${archive%/*}" && sha256sum -c "${archive##*/}.sha256" )
printf 'ICX20262_IMPI202119_PRIVATE_1N_PASS\n'
