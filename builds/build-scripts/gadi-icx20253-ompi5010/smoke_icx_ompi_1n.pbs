#!/bin/bash
# Test ICX 2025.3.2 against the retained Open MPI 5.0.10 build before OpenFOAM compilation.
#PBS -P pm78
#PBS -q normalsr
#PBS -N of_icx_ompi_probe
#PBS -l ncpus=4
#PBS -l mem=16GB
#PBS -l jobfs=8GB
#PBS -l walltime=00:20:00
#PBS -l storage=scratch/pm78
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/gadi-icx20253-ompi5010/submit-logs/smoke_icx_ompi_1n.pbs.out
set -euo pipefail
SOURCE_ROOT=/scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/gadi-gcc162-ompi5010
PROBE_ROOT=/scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/gadi-icx20253-ompi5010
GCC_ARCHIVE="$SOURCE_ROOT/runtime-archive/gcc-16.2.0.181342083.gadi-pbs.tar.gz"
MPI_ARCHIVE="$SOURCE_ROOT/runtime-archive/openmpi-5.0.10.181346004.gadi-pbs.tar.gz"
GCC_SHA=1149c0d97412ae3741cc18d60f233cdd3dd5e33bc92c55c59db2dd8cf535b714
MPI_SHA=8ac121e4f64eb329dc33cd2cc8229dc9f655064a757cbcaa36af962b21619fc6
JOB_ID=${PBS_JOBID:?}
JOBFS_ROOT="${PBS_JOBFS:?}/icx-ompi-probe-$JOB_ID"
EVIDENCE="$PROBE_ROOT/evidence/$JOB_ID"
GCC_PREFIX="$JOBFS_ROOT/gcc-16.2.0"
MPI_PREFIX="$JOBFS_ROOT/openmpi-5.0.10"
test "${PBS_NCPUS:?}" -eq 4
test ! -e "$JOBFS_ROOT"; test ! -e "$EVIDENCE"
printf '%s  %s\n' "$GCC_SHA" "$GCC_ARCHIVE" | sha256sum -c -
printf '%s  %s\n' "$MPI_SHA" "$MPI_ARCHIVE" | sha256sum -c -
mkdir -p "$JOBFS_ROOT" "$EVIDENCE"
exec > >(tee "$EVIDENCE/probe.log") 2>&1
printf 'job_id=%s\njobfs=%s\n' "$JOB_ID" "$PBS_JOBFS"
grep -m1 'model name' /proc/cpuinfo
module purge
module load intel-compiler-llvm/2025.3.2 ucx/1.18.1 ucc/1.4.4
module list 2>&1
test "${UCX_ROOT:?}" = /apps/ucx/1.18.1
test "${UCC_ROOT:?}" = /apps/ucc/1.4.4
icx --version | tee "$EVIDENCE/icx-version.txt"
icpx --version | tee "$EVIDENCE/icpx-version.txt"
grep -F '2025.3.2' "$EVIDENCE/icx-version.txt"
grep -F '2025.3.2' "$EVIDENCE/icpx-version.txt"
tar -xzf "$GCC_ARCHIVE" -C "$JOBFS_ROOT"
tar -xzf "$MPI_ARCHIVE" -C "$JOBFS_ROOT"
test -x "$GCC_PREFIX/bin/gcc"; test -x "$MPI_PREFIX/bin/mpicxx"
export OPAL_PREFIX="$MPI_PREFIX" PMIX_PREFIX="$MPI_PREFIX" PRTE_PREFIX="$MPI_PREFIX"
export OMPI_CC=icx OMPI_CXX=icpx
export PATH="$MPI_PREFIX/bin:$PATH"
export LD_LIBRARY_PATH="$MPI_PREFIX/lib:$GCC_PREFIX/lib64:/opt/pbs/default/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
mpirun --version | head -n 1 | grep -Fx 'mpirun (Open MPI) 5.0.10'
mpicc --showme:command | tee "$EVIDENCE/mpicc-wrapper.txt" | grep -Fx icx
mpicxx --showme:command | tee "$EVIDENCE/mpicxx-wrapper.txt" | grep -Fx icpx
cat > "$EVIDENCE/mpi-smoke.cpp" <<'CPP_EOF'
#include <mpi.h>
#include <cstdio>
#include <string>
int main(int argc, char **argv) {
    MPI_Init(&argc, &argv);
    int rank = -1, size = -1;
    MPI_Comm_rank(MPI_COMM_WORLD, &rank);
    MPI_Comm_size(MPI_COMM_WORLD, &size);
    std::string result = "ICX_OMPI_RANK_" + std::to_string(rank) + "_OF_" + std::to_string(size);
    std::puts(result.c_str());
    MPI_Finalize();
    return size == 2 ? 0 : 1;
}
CPP_EOF
mpicxx -O2 "$EVIDENCE/mpi-smoke.cpp" -o "$JOBFS_ROOT/mpi-smoke"
ldd "$JOBFS_ROOT/mpi-smoke" | tee "$EVIDENCE/mpi-smoke.ldd"
! grep -Fq 'not found' "$EVIDENCE/mpi-smoke.ldd"
grep -F "$MPI_PREFIX/lib/libmpi.so" "$EVIDENCE/mpi-smoke.ldd"
mpirun --mca pml ucx -np 2 "$JOBFS_ROOT/mpi-smoke" | tee "$EVIDENCE/mpi-smoke.txt"
grep -Fx ICX_OMPI_RANK_0_OF_2 "$EVIDENCE/mpi-smoke.txt"
grep -Fx ICX_OMPI_RANK_1_OF_2 "$EVIDENCE/mpi-smoke.txt"
echo ICX20253_OMPI5010_ABI_SMOKE_PASS
