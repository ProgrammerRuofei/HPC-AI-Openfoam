+grep -Fxq script_exit_rc=0 "$PREFLIGHT/exit-status.txt"
+python3 - "$PREFLIGHT/acceptance.json" <<'PY'
+import json,sys
+assert json.load(open(sys.argv[1]))['can_run_binding'], 'probe found no distinct binding treatment'
+PY
+test "$(sha256sum "$HELPER" | awk '{print $1}')" = "$(cat "$PREFLIGHT/helper.sha256")"
+RUN_ROOT="$OF_ROOT/binding-pair-1n-v1/$BIND_ORDER/${PBS_JOBID:?}"
+EVIDENCE="$RUN_ROOT/evidence"
+LOCAL_ROOT="${PBS_JOBFS:?}/of2512-icx20253-binding-pair-${PBS_JOBID}"
+GCC_PREFIX="$LOCAL_ROOT/gcc-16.2.0"
+MPI_PREFIX="$LOCAL_ROOT/openmpi-5.0.10"
+FOAM_ROOT="$LOCAL_ROOT/OpenFOAM-v2512"
+CURRENT_ARM=
+
+test "${PBS_NNODES:?}" -eq 1
+test "${PBS_NCPUS:?}" -eq 104
+test ! -e "$RUN_ROOT"
+test ! -e "$LOCAL_ROOT"
+mkdir -p "$EVIDENCE" "$LOCAL_ROOT"
+exec > >(tee "$EVIDENCE/run.log") 2>&1
+preserve() {
+    rc=$?; set +e
+    if [[ -n "$CURRENT_ARM" ]]; then
+        arm_evidence="$EVIDENCE/$CURRENT_ARM"
+        arm_case="$LOCAL_ROOT/case-$CURRENT_ARM"
+        coefficient=$(find "$arm_case/postProcessing/forceCoeffsAll" -name coefficient.dat -type f 2>/dev/null | head -n 1)
+        if test -n "$coefficient" && test ! -e "$arm_evidence/coefficient.dat"; then cp -p "$coefficient" "$arm_evidence/coefficient.dat"; fi
+    fi
