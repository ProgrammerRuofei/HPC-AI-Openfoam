+    assert sum(bool(re.match(r'^Processor \d+$',s)) for s in keep)==416
+    return keep
+assert geometry(a/'10_decomposePar.log')==geometry(b/'10_decomposePar.log'), 'partition differs'
+def result(p):
+    log=(p/'simpleFoam.log').read_text()
+    times=[float(x) for x in re.findall(r'^Time = ([0-9.]+)\s*$',log,re.M)]
+    assert re.search(r'^End$', log, re.M) and 'Finalising parallel run' in log
+    assert times==list(range(1,151)), 'solver steps differ'
+    t=float(re.findall(r'Average wall-clock time per time step\s*=\s*([0-9.eE+-]+)',log)[-1])
+    assert math.isfinite(t) and t>0
+    return t
+def cd_series(p):
+    columns=None; data=[]
+    for line in (p/'coefficient.dat').read_text().splitlines():
+        if line.startswith('#'):
+            fields=line.lstrip('#').split()
+            if 'Time' in fields and 'Cd' in fields: columns=fields
+        elif line.strip():
+            assert columns is not None
+            fields=line.split(); data.append((float(fields[0]),float(fields[columns.index('Cd')])))
+    assert data and all(math.isfinite(v) for row in data for v in row)
