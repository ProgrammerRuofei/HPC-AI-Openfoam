+ca,cb=cd_series(a),cd_series(b)
+assert [x[0] for x in ca]==[x[0] for x in cb], 'coefficient time points differ'
+max_cd_difference=max(abs(x[1]-y[1]) for x,y in zip(ca,cb))
+summary=dict(control_s_step=result(a),candidate_s_step=result(b),partition_identical=True,max_abs_Cd_difference=max_cd_difference,comparable_cd=max_cd_difference<=1e-8)
+summary['candidate_improvement_percent']=100*(summary['control_s_step']-summary['candidate_s_step'])/summary['control_s_step']
+(root/'evidence/pair-summary.json').write_text(json.dumps(summary,indent=2)+'\n')
+assert summary['comparable_cd'], 'rank-NUMA pair Cd changed: preserve and inspect, do not promote'
