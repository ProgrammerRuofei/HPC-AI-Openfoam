+        /opt/pbs/default/bin/pbsdsh -n "$idx" -s -- /bin/bash "$CONTROL_ROOT/experiments/gadi-icx20253-rank-numa/jobfs_receipt_4n.sh" "$PBS_JOBFS" "$reserve_kib" "$phase" "$receipt"
