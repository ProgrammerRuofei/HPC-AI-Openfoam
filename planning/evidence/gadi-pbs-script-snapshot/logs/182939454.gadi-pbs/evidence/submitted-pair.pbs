#!/bin/bash
# One authorized four-node ICX control/candidate rank-NUMA pair. Each arm is a fresh 150-step solve.
# Submit from the reviewed isolated checkout; unique stdout; no retries.
#PBS -P pm78
#PBS -q normalsr
#PBS -N icx25_ranknuma4n_pair_v2
#PBS -l ncpus=416
#PBS -l mem=760GB
#PBS -l jobfs=400GB
#PBS -l walltime=01:00:00
#PBS -l storage=scratch/pm78
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/gadi-icx20253-ompi5010/submit-logs/run_rank_numa_pair_4n_v2.pbs.out
set -euo pipefail
SECONDS=0
cd "${PBS_O_WORKDIR:?}"
CONTROL_ROOT=$PWD
PAIR_ROOT="/scratch/pm78/kj7183/openfoam_cpu/toolchain-screening/gadi-icx20253-ompi5010-of2512/rank-numa-pair-4n-v2/${PBS_JOBID:?}"
test "${PBS_NNODES:?}" -eq 4; test "${PBS_NCPUS:?}" -eq 416
test ! -e "$PAIR_ROOT"
test "${PBS_NCI_JOBFS:?}" = 400gb
test -z "${LD_PRELOAD:-}"; test -z "${OMPI_MCA_coll:-}"
mkdir -p "$PAIR_ROOT/evidence"
exec > >(tee "$PAIR_ROOT/evidence/pair.log") 2>&1
PAIR_COMPLETE=0
finish_pair() {
    rc=$?; trap - EXIT; set +e
    if (( rc == 0 && PAIR_COMPLETE != 1 )); then rc=1; fi
    printf 'pair_exit_rc=%s\n' "$rc" > "$PAIR_ROOT/evidence/exit-status.txt"
    exit "$rc"
}
trap finish_pair EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
trap 'exit 129' HUP
printf 'pbs_jobid=%s\norder=control,candidate\nsteps_per_arm=150\nranks_per_arm=416\n' "$PBS_JOBID" > "$PAIR_ROOT/evidence/provenance.txt"
git rev-parse HEAD >> "$PAIR_ROOT/evidence/provenance.txt"
cp -p "$0" "$PAIR_ROOT/evidence/submitted-pair.pbs"
cat > "$PAIR_ROOT/evidence/expected-scripts.sha256" <<'HASHES'
a5b69bb03327069ff9e96ce7ab14cb061ce6ba16e6ed465495edb249659c17ed  experiments/gadi-icx20253-rank-numa/topology_receipt_4n_v2.sh
95cdc642dab5ffe4db9e12212cbdbbca242e30d236585f1ec7797a48c023279d  experiments/gadi-icx20253-rank-numa/run_rank_numa_arm_4n_v2.sh
f6b67603d54603a36265cae63ab5340b7d29f35f33be89168916515bf896feb7  experiments/gadi-icx20253-rank-numa/rank_numa_4n.py
73e5bdf8d1ebb85058b873f4ab08fa65d7fe6a8001fc78960570e650bb4c88d3  experiments/gadi-icx20253-rank-numa/rank_numa_probe_4n.c
877d5bdcff2c821c06c60b3a538a3d697d43cae8633832522113867800d2ba86  experiments/gadi-icx20253-rank-numa/jobfs_receipt_4n.sh
b82e7f750816a3f0b9fb5951ee7be00f83b2c75ec02e8be6454c4c7a8fda3c91  experiments/gadi-icx20253-rank-numa/candidate-map-v1.csv
ea9a0fca74e1bc52cac4984a75c95072227ee3c437b37d9998e43b5ed380dd06  builds/build-scripts/gadi-icx20253-ompi5010/stage_4n_runtime_node.sh
2caa257b7ede430a638b97eed8a2b88e91f4b019cd9a828e0bcb05b1f9a2fa2e  builds/build-scripts/gadi-icx20253-ompi5010/stage_4n_processors_node.sh
HASHES
sha256sum -c "$PAIR_ROOT/evidence/expected-scripts.sha256"
# PBS divides 400GiB across four nodes. Check allocated-quota headroom,
# not df free space (which describes the physical device, not this job's quota).
jobfs_receipts() {
    phase=$1; reserve_kib=$2
    for idx in 0 104 208 312; do
        receipt="$PAIR_ROOT/evidence/jobfs-$phase-$idx.txt"
        /opt/pbs/default/bin/pbsdsh -n "$idx" -s -- /bin/bash "$CONTROL_ROOT/experiments/gadi-icx20253-rank-numa/jobfs_receipt_4n.sh" "$PBS_JOBFS" "$reserve_kib" "$phase" "$receipt"
        test -s "$receipt"
    done
}
for arm in control candidate; do
    cd "$CONTROL_ROOT"
    # Leave 25 minutes for a complete second arm and exit; never start it late.
    if (( SECONDS > 2100 )); then echo 'Insufficient remaining walltime' >&2; exit 3; fi
    jobfs_receipts "before-$arm" "$((50 * 1024 * 1024))"
    NUMA_ARM="$arm" /bin/bash experiments/gadi-icx20253-rank-numa/run_rank_numa_arm_4n_v2.sh > "$PAIR_ROOT/evidence/$arm.stdout" 2>&1
    grep -Fxq "ICX20253_OMPI5010_RANK_NUMA_4N_150STEP_${arm}_V2_PASS" "$PAIR_ROOT/$arm/evidence/run.log"
    grep -Fxq script_exit_rc=0 "$PAIR_ROOT/$arm/evidence/exit-status.txt"
    jobfs_receipts "after-$arm" 0
done
python3 - "$PAIR_ROOT" <<'PYPAIR'
from pathlib import Path
import re,sys,math,json
root=Path(sys.argv[1]); a=root/'control/evidence'; b=root/'candidate/evidence'
def receipts(p):
    return sorted([json.loads(x.read_text()) for x in p.glob('rank-*.json')],key=lambda x:x['rank'])
for x,y in zip(receipts(a/'baseline'),receipts(b/'baseline')):
    for key in ['rank','local_rank','host','cpus','cores','numa','mems_allowed_list']:assert x[key]==y[key], ('arm baseline mismatch',key)
for x,y in zip(receipts(a/'mpi-runtime'),receipts(b/'mpi-runtime')):
    for key in ['rank','host','ucp_path','ucp_version']:assert x[key]==y[key], ('runtime mismatch',key)
assert (a/'case-inputs.sha256').read_bytes()==(b/'case-inputs.sha256').read_bytes()
def geometry(p):
    lines=p.read_text().splitlines()
    keep=[s.strip() for s in lines if re.match(r'^Processor \d+$',s) or re.match(r'\s+Number of (cells|points|faces shared with processor|processor patches|processor faces|boundary faces)',s)]
    assert sum(bool(re.match(r'^Processor \d+$',s)) for s in keep)==416
    return keep
assert geometry(a/'10_decomposePar.log')==geometry(b/'10_decomposePar.log'), 'partition differs'
def result(p):
    log=(p/'simpleFoam.log').read_text()
    times=[float(x) for x in re.findall(r'^Time = ([0-9.]+)\s*$',log,re.M)]
    assert re.search(r'^End$', log, re.M) and 'Finalising parallel run' in log
    assert times==list(range(1,151)), 'solver steps differ'
    t=float(re.findall(r'Average wall-clock time per time step\s*=\s*([0-9.eE+-]+)',log)[-1])
    assert math.isfinite(t) and t>0
    return t
def cd_series(p):
    columns=None; data=[]
    for line in (p/'coefficient.dat').read_text().splitlines():
        if line.startswith('#'):
            fields=line.lstrip('#').split()
            if 'Time' in fields and 'Cd' in fields: columns=fields
        elif line.strip():
            assert columns is not None
            fields=line.split(); data.append((float(fields[0]),float(fields[columns.index('Cd')])))
    assert data and all(math.isfinite(v) for row in data for v in row)
    return data
ca,cb=cd_series(a),cd_series(b)
assert [x[0] for x in ca]==[x[0] for x in cb], 'coefficient time points differ'
max_cd_difference=max(abs(x[1]-y[1]) for x,y in zip(ca,cb))
summary=dict(control_s_step=result(a),candidate_s_step=result(b),partition_identical=True,max_abs_Cd_difference=max_cd_difference,comparable_cd=max_cd_difference<=1e-8)
summary['candidate_improvement_percent']=100*(summary['control_s_step']-summary['candidate_s_step'])/summary['control_s_step']
(root/'evidence/pair-summary.json').write_text(json.dumps(summary,indent=2)+'\n')
assert summary['comparable_cd'], 'rank-NUMA pair Cd changed: preserve and inspect, do not promote'
PYPAIR
echo ICX20253_OMPI5010_RANK_NUMA_PAIR_4N_150STEP_V2_PASS
PAIR_COMPLETE=1
